---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '/index.html';
const baseHref = isHome ? 'pages/' : '';
const homeHref = isHome ? '/' : '../index.html';
---

<footer class="footer" transition:persist="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="logo">
        <span class="logo-mark">F</span>
        <span>fitty.ar</span>
      </div>
      <p class="section-subtitle">
        Construido y desplegado desde Buenos Aires. Infraestructura propia,
        código propio.
      </p>
    </div>
    <div>
      <strong>Navegación</strong>
      <div class="link-list">
        <a href={homeHref}>Inicio</a>
        <a href={`${baseHref}about.html`}>Sobre mí</a>
        <a href={`${baseHref}projects.html`}>Proyectos</a>
        <a href={`${baseHref}stack.html`}>Stack</a>
        <a href={`${baseHref}contact.html`}>Contacto</a>
      </div>
    </div>
    <div>
      <strong>Contacto</strong>
      <div class="link-list">
        <a href="mailto:hola@fitty.ar">hola@fitty.ar</a>
        <a href="https://github.com/FittyAr" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.instagram.com/fitty.ar">Instagram</a>
        <a href="https://www.linkedin.com/">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
