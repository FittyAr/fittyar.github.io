---
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/pages/about.html' },
  { label: 'Proyectos', href: '/pages/projects.html' },
  { label: 'Stack', href: '/pages/stack.html' },
  { label: 'Contacto', href: '/pages/contact.html' },
] as const;

const projectItems = [
  { label: 'PolyglotCLI', href: '/pages/polyglot-cli.html' },
  { label: 'ElectroObra', href: '/pages/electro-obra.html' },
  { label: 'Flota-HAS', href: '/pages/flota-has.html' },
  { label: 'Cardfile', href: '/pages/cardfile.html' },
  { label: 'Ecos del Obelisco', href: '/pages/ecos-del-obelisco.html' },
  { label: 'Gestión Empresarial', href: '/pages/business-management.html' },
] as const;

const year = new Date().getFullYear();
---

<footer class="footer" transition:persist="site-footer">
  <div class="layout">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="/" aria-label="Inicio - fitty.ar">
          <span class="logo-mark" aria-hidden="true">F</span>
          <span class="logo-text">fitty<span class="tld">.ar</span></span>
        </a>
        <p class="footer-tagline">
          Construido y desplegado desde Buenos Aires. Infraestructura propia,
          código propio.
        </p>
        <div class="footer-status">
          <span class="dot" aria-hidden="true"></span>
          <span>Sistemas operativos · uptime propio</span>
        </div>
      </div>

      <div class="footer-col">
        <h4>Navegación</h4>
        <ul>
          {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Proyectos</h4>
        <ul>
          {projectItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contacto</h4>
        <ul>
          <li><a href="mailto:hola@fitty.ar">hola@fitty.ar</a></li>
          <li><a href="https://github.com/FittyAr" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li>Discord · fitty.ar</li>
          <li><a href="https://x.com/fittyar" target="_blank" rel="noopener noreferrer">X</a></li>
          <li><a href="https://www.instagram.com/fitty.ar" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="https://www.linkedin.com/in/fittyar" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} fitty.ar · Hecho en Argentina</span>
      <span class="footer-version">
        <strong>v3.0</strong> · Astro · JetBrains&nbsp;Mono · Amber phosphor
      </span>
    </div>
  </div>
</footer>
