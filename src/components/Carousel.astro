---
// Carrusel de imagenes minimal, sin dependencias externas.
// - Una imagen visible a la vez, transicion con transform.
// - Prev/next + dots indicadores + keyboard (flechas) + touch swipe.
// - Si images.length === 1, oculta los controles.

interface Props {
  /** Lista de URLs de imagenes en el orden en que se deben ver. */
  images: string[];
  /** Nombre del proyecto. Se usa para el aria-label del carrusel y para
      generar el alt text accesible de cada slide. */
  label: string;
}

const { images, label } = Astro.props;
const hasControls = images.length > 1;
---

<div
  class="carousel"
  data-carousel
  data-total={images.length}
  aria-roledescription="carrusel"
  aria-label={`Capturas de ${label}`}
  tabindex="0"
>
  <div class="carousel-viewport">
    <div class="carousel-track" data-track>
      {images.map((src, i) => (
        <div
          class="carousel-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${images.length}`}
        >
          <img
            src={src}
            alt={`Captura ${i + 1} de ${label}`}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  {hasControls && (
    <>
      <button
        class="carousel-btn carousel-btn-prev"
        type="button"
        aria-label="Anterior"
        data-prev
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="carousel-btn carousel-btn-next"
        type="button"
        aria-label="Siguiente"
        data-next
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
      <div class="carousel-dots" role="tablist" aria-label="Selector de slide">
        {images.map((_, i) => (
          <button
            class:list={["carousel-dot", i === 0 && "is-active"]}
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={`Ir a la captura ${i + 1}`}
            data-dot={i}
          />
        ))}
      </div>
    </>
  )}
</div>

<script>
  type CarouselEl = HTMLElement & { _carouselInited?: boolean };

  function initCarousel(root: CarouselEl) {
    if (root._carouselInited) return;
    root._carouselInited = true;

    const track = root.querySelector<HTMLElement>("[data-track]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    if (!track) return;

    const total = parseInt(root.dataset.total ?? "0", 10);
    if (!Number.isFinite(total) || total <= 1) return;

    let current = 0;

    function goTo(i: number) {
      current = ((i % total) + total) % total;
      track!.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, idx) => {
        const active = idx === current;
        d.classList.toggle("is-active", active);
        d.setAttribute("aria-selected", active ? "true" : "false");
      });
    }

    prev?.addEventListener("click", () => goTo(current - 1));
    next?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goTo(current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        goTo(current + 1);
      }
    });

    // Swipe basico para mobile.
    let startX = 0;
    let isDragging = false;
    root.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        isDragging = true;
      },
      { passive: true },
    );
    root.addEventListener(
      "touchend",
      (e) => {
        if (!isDragging) return;
        const endX = e.changedTouches[0]?.clientX ?? startX;
        const diff = startX - endX;
        if (Math.abs(diff) > 40) {
          goTo(diff > 0 ? current + 1 : current - 1);
        }
        isDragging = false;
      },
      { passive: true },
    );

    goTo(0);
  }

  function initAll() {
    document.querySelectorAll<CarouselEl>("[data-carousel]").forEach(initCarousel);
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
    border: 1px solid var(--color-border, rgba(255, 176, 0, 0.2));
    border-radius: var(--radius, 8px);
    background: var(--color-bg-soft, rgba(0, 0, 0, 0.25));
    overflow: hidden;
    outline: none;
  }

  .carousel:focus-visible {
    border-color: var(--color-amber, #ffb000);
    box-shadow: 0 0 0 2px rgba(255, 176, 0, 0.3);
  }

  .carousel-viewport {
    overflow: hidden;
    position: relative;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    transition: transform 400ms ease;
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3);
    box-sizing: border-box;
  }

  .carousel-slide img {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    height: auto;
    width: auto;
    border-radius: 4px;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid var(--color-amber, #ffb000);
    color: var(--color-amber, #ffb000);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition:
      background 200ms ease,
      transform 200ms ease;
    padding: 0;
  }

  .carousel-btn:hover {
    background: rgba(255, 176, 0, 0.2);
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-amber, #ffb000);
    outline-offset: 2px;
  }

  .carousel-btn-prev {
    left: var(--s-3);
  }

  .carousel-btn-next {
    right: var(--s-3);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3);
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 176, 0, 0.25);
    border: 0;
    cursor: pointer;
    padding: 0;
    transition: background 200ms ease;
  }

  .carousel-dot:hover {
    background: rgba(255, 176, 0, 0.5);
  }

  .carousel-dot.is-active {
    background: var(--color-amber, #ffb000);
  }

  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-amber, #ffb000);
    outline-offset: 2px;
  }
</style>
