---
// Paths absolutos desde la raíz del sitio.
// Funcionan correctamente en la home, en subpáginas y bajo View Transitions.
const navItems = [
  { label: 'Sobre mí', href: '/pages/about.html' },
  { label: 'Proyectos', href: '/pages/projects.html' },
  { label: 'Stack', href: '/pages/stack.html' },
  { label: 'Contacto', href: '/pages/contact.html' },
] as const;
---

<header class="topbar" transition:persist="site-header">
  <div class="layout nav">
    <a class="logo" href="/" aria-label="Inicio - fitty.ar">
      <span class="logo-mark" aria-hidden="true">F</span>
      <span class="logo-text">fitty<span class="tld">.ar</span></span>
    </a>

    <nav class="nav-links" id="primary-nav" aria-label="Navegación principal">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        href="https://github.com/FittyAr"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon-button"
        title="GitHub"
        aria-label="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.1.79-.25.79-.56v-2.06c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
      </a>

      <a class="button button-primary" href="/pages/contact.html">
        Hablemos
        <span class="button-arrow" aria-hidden="true">→</span>
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>
