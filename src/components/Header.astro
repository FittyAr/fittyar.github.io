---
import { useTranslations, localizeHref, swapLocaleInPath, isLocale, DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { key: 'chrome.nav.about', href: localizeHref('/pages/about.html', locale) },
  { key: 'chrome.nav.projects', href: localizeHref('/pages/projects.html', locale) },
  { key: 'chrome.nav.stack', href: localizeHref('/pages/stack.html', locale) },
  { key: 'chrome.nav.contact', href: localizeHref('/pages/contact.html', locale) },
] as const;

const homeHref = localizeHref('/', locale);

// Para el switcher: el otro locale.
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const otherLocaleLabel = isLocale(locale)
  ? t(`chrome.lang_switch.${otherLocale}_label`)
  : '';

// URL actual apuntando al otro locale (para el link del switcher).
const pathname = Astro.url.pathname;
const switchHref = swapLocaleInPath(pathname, otherLocale);
---

<!--
  Importante: NO usamos `transition:persist` acá. El switcher de idioma y los
  links de nav son locale-aware (cambian según el locale actual). Si
  persistimos el Header, su contenido queda "congelado" con los valores de
  la primera página y el switcher apunta siempre al mismo destino.
-->
<header class="topbar">
  <div class="layout nav">
    <a class="logo" href={homeHref} aria-label={t('chrome.logo_aria')}>
      <span class="logo-mark" aria-hidden="true">F</span>
      <span class="logo-text">fitty<span class="tld">.ar</span></span>
    </a>

    <nav class="nav-links" id="primary-nav" aria-label={t('chrome.primary_nav_aria')}>
      {navItems.map((item) => <a href={item.href}>{t(item.key)}</a>)}
    </nav>

    <div class="header-actions">
      <!--
        Switcher de idioma: un anchor simple. Al hacer click guardamos la
        preferencia en localStorage para no auto-redirigir al usuario después.
        El script inline en el <head> lo lee antes de cualquier redirect.
      -->
      <a
        class="lang-switch"
        href={switchHref}
        hreflang={otherLocale}
        aria-label={t('chrome.lang_switch.aria')}
        title={t('chrome.lang_switch.aria')}
        data-set-locale={otherLocale}
      >
        <span class="lang-switch-current" aria-hidden="true">{locale.toUpperCase()}</span>
        <span class="lang-switch-sep" aria-hidden="true">/</span>
        <span class="lang-switch-other" aria-hidden="true">{otherLocale.toUpperCase()}</span>
      </a>

      <a
        href="https://github.com/FittyAr"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon-button"
        title={t('chrome.github_aria')}
        aria-label={t('chrome.github_aria')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.1.79-.25.79-.56v-2.06c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
      </a>

      <a class="button button-primary" href={localizeHref('/pages/contact.html', locale)}>
        {t('chrome.cta_lets_talk')}
        <span class="button-arrow" aria-hidden="true">→</span>
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-label={t('chrome.open_menu_aria')}
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Persistir la elección del switcher en localStorage.
  // El script inline en <head> lo lee antes de redirigir.
  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target.closest('.lang-switch') : null;
    if (!target) return;
    const locale = target.getAttribute('data-set-locale');
    if (locale) {
      try { localStorage.setItem('fitty.locale', locale); } catch (_) {}
    }
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-muted, #9a9a9a);
    background: transparent;
    border: 1px solid var(--border, #2a2a30);
    border-radius: 6px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .lang-switch:hover {
    color: var(--amber, #ffb454);
    border-color: var(--amber, #ffb454);
  }
  .lang-switch-current {
    color: var(--text, #e7e7ea);
  }
  .lang-switch-sep {
    opacity: 0.5;
  }
  .lang-switch-other {
    opacity: 0.7;
  }
  .lang-switch:hover .lang-switch-other {
    color: var(--amber, #ffb454);
    opacity: 1;
  }
</style>
