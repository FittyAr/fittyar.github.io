---
// Página mínima que solo redirige a `to`. Sirve para mantener vivas URLs
// viejas (proyectos que se mudaron a su propio sitio, links externos rotos).
// No se indexa y queda fuera del sitemap (ver astro.config.mjs).
interface Props {
  to: string;
}
const { to } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <title>fitty.ar</title>
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <script is:inline define:vars={{ to }}>window.location.replace(to);</script>
    <style>html, body { margin: 0; background: #0a0a0d; color: #f5f5f7; font-family: ui-monospace, monospace; }</style>
  </head>
  <body>
    <p><a href={to} style="color: #ffb86c;">{to}</a></p>
  </body>
</html>
