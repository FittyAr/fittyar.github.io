---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Pairee',
    desc: 'File manager TUI dual-panel en Rust con Ratatui y Tokio. Rápido, moderno, terminal-first.',
    tags: ['rust', 'tui', 'systems'],
    href: 'https://pairee.fitty.ar',
    external: true,
  },
  {
    title: 'PolyglotCLI',
    desc: 'Traductor incremental de PDFs en .NET 10. OCR con LLMs de visión locales vía LM Studio.',
    tags: ['.net 10', 'csharp', 'lm studio'],
    href: '/pages/polyglot-cli.html',
  },
  {
    title: 'ElectroObra',
    desc: 'Gestión operativa y flujo de caja para construcción. .NET 10 con Avalonia UI y SQLite.',
    tags: ['.net', 'avalonia', 'sqlite'],
    href: '/pages/electro-obra.html',
  },
  {
    title: 'Flota-HAS',
    desc: 'Ride-hailing manager local-first. .NET MAUI + EF Core + SQLite, sin servidor obligatorio.',
    tags: ['.net maui', 'ef core', 'sqlite'],
    href: '/pages/flota-has.html',
  },
  {
    title: 'Cardfile',
    desc: 'Gestor de tarjetas multiplataforma con estética Windows 3.1. Python + Flet.',
    tags: ['python', 'flet', 'markdown'],
    href: '/pages/cardfile.html',
  },
  {
    title: 'Ecos del Obelisco',
    desc: 'Videojuego en Godot Engine. Narrativas inmersivas y mecánicas desde cero.',
    tags: ['godot', 'game dev'],
    href: '/pages/ecos-del-obelisco.html',
  },
] as const;

const pillars = [
  {
    icon: '⟨/⟩',
    title: 'Full Stack .NET',
    body: 'Aplicaciones robustas en C# y Blazor Server. Diseño APIs, lógica de negocio y frontends con foco en performance.',
  },
  {
    icon: '⚙',
    title: 'SysAdmin & Ops',
    body: 'Virtualización con Proxmox, Docker, Linux (Debian/Zentyal), Nginx y Ollama para IA local.',
  },
  {
    icon: '◆',
    title: 'Game Dev con Godot',
    body: 'Mecánicas, narrativa y prototipado. Ecos del Obelisco como vehículo de exploración.',
  },
  {
    icon: '⌘',
    title: 'Systems en Rust',
    body: 'Tooling, CLIs y servicios de bajo nivel cuando la performance o la seguridad lo exigen.',
  },
] as const;

const notes = [
  { tag: 'infra', title: 'Dominio .ar + Cloudflare', desc: 'DNS y certs para operar stack propio con NIC.ar.' },
  { tag: 'rust', title: 'Primeros pasos en Rust', desc: 'Experimentos con tooling, CLIs y servicios livianos.' },
  { tag: 'lab', title: 'Proxmox casero', desc: 'Virtualización, redes internas y despliegues Debian.' },
  { tag: 'ai', title: 'Ollama local', desc: 'Modelos on-prem para visión y code-assist sin salir del laburo.' },
] as const;
---

<Layout
  title="fitty.ar | Ingeniería de Software y Game Dev"
  description="Desarrollador .NET, entusiasta de Rust y creador de videojuegos en Godot. Desde infraestructura hasta mundos virtuales."
  withStructuredData
>
  <!-- ========================================================== HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Disponible para colaboraciones
        </span>

        <h1 class="hero-title">
          Ingeniería de <span class="accent">software</span>,<br />
          infraestructura y <span class="accent-cyan">mundos virtuales</span>.
        </h1>

        <div class="hero-terminal" aria-label="Línea de comando">
          <span class="prompt">$</span>
          <span class="cmd">whoami</span>
          <span class="muted">→</span>
          <span class="amber">fitty</span>
          <span class="muted">// .net · rust · godot · proxmox</span>
        </div>

        <p class="hero-subtitle">
          Desarrollo software de punta a punta: desde servidores en Proxmox
          hasta experiencias interactivas y videojuegos. Código, infra y un
          poco de criterio en cada decisión.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/pages/projects.html">
            Ver proyectos
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
          <a class="button button-ghost" href="/pages/stack.html">
            Explorar stack
          </a>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <span class="k">Base</span>
            <span class="v">Buenos Aires, AR</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Stack</span>
            <span class="v">.NET · Rust · Godot</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Infra</span>
            <span class="v">Proxmox · Debian · Nginx</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Local-first</span>
            <span class="v">IA con Ollama on-prem</span>
          </div>
        </div>
      </div>

      <!-- ===== Terminal / status card ===== -->
      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/laburador — bash</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">fitty@lab</span>
            <span class="terminal-cmd">:~$ cat ./now.md</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">// <span class="key">en curso</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="ok">Ecos del Obelisco</span> · Godot 4 + GDScript</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="ok">PolyglotCLI v2</span> · .NET 10, OCR local</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="warn">Pairee</span> · refactor del event loop</span>
          </div>
          <div class="terminal-line" style="margin-top: var(--s-3);">
            <span class="terminal-prompt">fitty@lab</span>
            <span class="terminal-cmd">:~$ ls ./skills/</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">
              backend <span class="key">csharp</span> <span class="key">dotnet</span> systems
              <span class="key">rust</span> devops linux infra game-dev godot
            </span>
          </div>
          <div class="terminal-line" style="margin-top: var(--s-3);">
            <span class="terminal-prompt">fitty@lab</span>
            <span class="terminal-cmd">:~$<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== PILLARS -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Pilares técnicos</span>
        <h2 class="section-title">Cuatro focos, una sola forma de trabajar.</h2>
        <p class="section-subtitle">
          Cómo diseño, desarrollo y opero sistemas. Software que se puede
          mantener, infra que se puede entender.
        </p>
      </div>
      <div class="grid grid-2">
        {pillars.map((p, i) => (
          <article class="card card-feature reveal">
            <div class="card-icon" aria-hidden="true">{p.icon}</div>
            <h3>
              <span class="muted" style="font-weight: 500; font-size: 0.85em; margin-right: 0.5em;">
                0{i + 1}
              </span>
              {p.title}
            </h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================== PROJECTS -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Proyectos</span>
        <h2 class="section-title">Lo que está en producción o en camino.</h2>
        <p class="section-subtitle">
          Software real, desplegado, con usuarios o en etapas de maduración.
          Cada uno con su página.
        </p>
      </div>
      <div class="grid grid-3">
        {projects.map((p) => (
          <a
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
            class="card reveal"
          >
            <h3 class="card-title">{p.title}</h3>
            <p class="card-body">{p.desc}</p>
            <ul class="tag-list">
              {p.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <div class="card-footer">
              <span>{p.external ? 'Ver en producción' : 'Leer más'}</span>
              <span class="card-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <div class="inline-actions" style="margin-top: var(--s-8);">
        <a class="button button-ghost" href="/pages/projects.html">
          Ver todos los proyectos
          <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================================== STACK HIGHLIGHTS -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <div class="section-header">
            <span class="section-eyebrow">Stack</span>
            <h2 class="section-title">Lo que uso, en serio.</h2>
            <p class="section-subtitle">
              Un perfil técnico que combina software, infraestructura y
              videojuegos. Sin buzzwords, solo herramientas que probé.
            </p>
          </div>

          <div class="stack-group">
            <div class="stack-group-head">Runtimes & Lenguajes</div>
            <div class="stack-grid">
              <div class="stack-item"><span class="stack-item-dot"></span><span class="stack-item-name">C# / .NET 10</span><span class="stack-item-meta">main</span></div>
              <div class="stack-item"><span class="stack-item-dot"></span><span class="stack-item-name">Rust</span><span class="stack-item-meta">systems</span></div>
              <div class="stack-item"><span class="stack-item-dot"></span><span class="stack-item-name">GDScript</span><span class="stack-item-meta">godot</span></div>
              <div class="stack-item"><span class="stack-item-dot"></span><span class="stack-item-name">Python</span><span class="stack-item-meta">tools</span></div>
              <div class="stack-item"><span class="stack-item-dot"></span><span class="stack-item-name">TypeScript</span><span class="stack-item-meta">web</span></div>
            </div>
          </div>
        </div>

        <div class="terminal reveal">
          <div class="terminal-header">
            <span class="terminal-dots" aria-hidden="true">
              <span class="terminal-dot r"></span>
              <span class="terminal-dot y"></span>
              <span class="terminal-dot g"></span>
            </span>
            <span class="terminal-title">~/stack/inventory</span>
            <span style="width: 36px;" aria-hidden="true"></span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span class="terminal-cmd">cat infra.yml</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">virt</span>: proxmox ve 8</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">os</span>: debian 12, zentyal</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">web</span>: nginx + let's encrypt</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">db</span>: postgres · sqlite · ef core</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">ci</span>: github actions</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out"><span class="key">ai</span>: ollama on-prem (qwen, llama)</span>
            </div>
            <div class="terminal-line" style="margin-top: var(--s-3);">
              <span class="terminal-out muted">// todo en infra propia, sin hyperscalers.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== NOTES -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Bitácora</span>
        <h2 class="section-title">Notas, fixes, descubrimientos.</h2>
        <p class="section-subtitle">
          Registro técnico público de lo que aprendo en el camino.
        </p>
      </div>
      <div class="grid grid-2">
        {notes.map((n, i) => (
          <article class="card reveal">
            <div style="display: flex; align-items: center; gap: var(--s-3);">
              <span class={`tag ${i % 2 === 0 ? 'tag-amber' : 'tag-cyan'}`}>#{n.tag}</span>
              <h3 class="card-title" style="font-size: var(--fs-md);">{n.title}</h3>
            </div>
            <p class="card-body">{n.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================== CTA -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <div class="cta-content">
          <span class="section-eyebrow">Colaboraciones</span>
          <h2 class="cta-title">
            ¿Te interesa el desarrollo .NET, Rust o el diseño de
            videojuegos?
          </h2>
          <p class="section-subtitle">
            Hablemos de infraestructura, software a medida o experiencias
            interactivas. Sin compromiso, con café.
          </p>
          <div class="cta-actions">
            <a class="button button-primary" href="/pages/contact.html">
              Iniciar conversación
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a class="button button-ghost" href="/pages/about.html">
              Sobre mí
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
