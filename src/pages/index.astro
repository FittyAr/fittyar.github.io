---
// Stub mínimo: redirige / a /es.html con un meta refresh.
// La home real vive en `src/pages/[lang]/index.astro` y se renderiza
// para cada locale (Astro genera `/es.html` y `/en.html` desde el
// directorio dinámico).
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>fitty.ar</title>
    <meta http-equiv="refresh" content="0;url=/es.html" />
    <link rel="canonical" href="/es.html" />
  </head>
  <body>
    <p>Redirigiendo a <a href="/es.html">/es.html</a>...</p>
  </body>
</html>
