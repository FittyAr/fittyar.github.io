---
import Layout from '../layouts/Layout.astro';

const featured = [
  {
    title: 'Pairee',
    role: 'File manager TUI en Rust',
    desc: 'Gestor de archivos dual-panel para terminal, rápido y moderno. Diseñado para gente que vive en la consola.',
    long: 'Construido con Rust, Ratatui y Tokio. Event loop asíncrono, keybindings personalizables y vista previa de archivos. Pensado para rendimiento y portabilidad.',
    tags: ['rust', 'ratatui', 'tokio', 'tui'],
    href: 'https://apps.microsoft.com/detail/9PBSDNBTP2JZ',
    external: true,
    externalLabel: 'Ver en Microsoft Store',
    highlight: 'rust',
    stack: ['ratatui · tui', 'tokio · async', 'rust 1.75+', 'dual-panel'],
  },
  {
    title: 'PolyglotCLI',
    role: 'Traductor de PDFs en .NET 10',
    desc: 'Traducción incremental página por página, con extracción nativa o OCR con modelos de visión locales.',
    long: '.NET 10 y C#. Pensado para traducciones largas sin reventar la memoria. Compatible con LM Studio y Ollama para el modo OCR.',
    tags: ['.net 10', 'csharp', 'ocr', 'llm local'],
    href: '/pages/polyglot-cli.html',
    highlight: 'dotnet',
    stack: ['.NET 10 · C#', 'PdfPig + Skia', 'OCR · LM Studio', 'streaming write'],
  },
] as const;

const projects = [
  {
    title: 'ElectroObra',
    role: 'Gestión operativa para construcción',
    desc: 'Sistema de gestión y flujo de caja para pymes de construcción y mantenimiento.',
    long: 'Multiplataforma con Avalonia UI y SQLite, siguiendo Clean Architecture.',
    tags: ['.net 10', 'avalonia', 'sqlite'],
    href: '/pages/electro-obra.html',
    status: 'comercial',
  },
  {
    title: 'Flota-HAS',
    role: 'Gestión de flotas ride-hailing',
    desc: 'Aplicación multiplataforma para control de flotas, choferes y recaudación.',
    long: 'Local-first con .NET MAUI, EF Core y SQLite. Funciona sin servidor.',
    tags: ['.net maui', 'ef core', 'sqlite', 'local-first'],
    href: '/pages/flota-has.html',
    status: 'comercial',
  },
  {
    title: 'Cardfile',
    role: 'Gestor de tarjetas multiplataforma',
    desc: 'Organizador de tarjetas y notas con estética retro Windows 3.1.',
    long: 'Python + Flet. Multiidioma, base relacional.',
    tags: ['python', 'flet', 'markdown'],
    href: '/pages/cardfile.html',
  },
  {
    title: 'Ecos del Obelisco',
    role: 'Videojuego en Godot',
    desc: 'Narrativas inmersivas y mecánicas diseñadas desde cero.',
    long: 'Godot 4 + GDScript. Actualmente en fase de diseño.',
    tags: ['godot 4', 'gdscript', 'game dev'],
    href: '/pages/ecos-del-obelisco.html',
    status: 'diseño',
  },
  {
    title: 'Catálogo Techparts',
    role: 'Catálogo comercial (legacy)',
    desc: 'Sistema de catálogo de productos para comercio de repuestos. Mi primer proyecto comercial vendido y puesto en producción.',
    long: 'Desarrollado hace varios años. Hoy en producción opera un sistema más grande, este quedó deprecado. Próximamente agrego fotos y más contexto.',
    tags: ['legacy', 'comercial'],
    status: 'próximamente',
  },
] as const;

const focus = [
  {
    icon: '⟨/⟩',
    title: 'Software a medida',
    body: 'Aplicaciones web y de escritorio en C# y Blazor. APIs, lógica de negocio y UI, con foco en mantenibilidad.',
  },
  {
    icon: '◆',
    title: 'Multiplataforma',
    body: 'Desktop y mobile con .NET MAUI y Avalonia. Local-first cuando se puede: SQLite, sync opcional.',
  },
  {
    icon: '⌘',
    title: 'Tooling y CLIs',
    body: 'Utilidades de línea de comando en Rust. Performance, portabilidad y una buena experiencia de teclado.',
  },
  {
    icon: '◉',
    title: 'Juegos en Godot',
    body: 'Diseño y prototipado en Godot. Narrativa, mecánicas y exploración. Ecos del Obelisco en fase de diseño.',
  },
] as const;
---

<Layout
  title="fitty.ar | Software a medida en .NET, Rust y Godot"
  description="Desarrollo software a medida: aplicaciones .NET, herramientas en Rust y juegos en Godot. Productos propios y proyectos comerciales en producción."
  withStructuredData
>
  <!-- ========================================================== HERO -->
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Disponible para software a medida
        </span>

        <h1 class="hero-title">
          Software a medida en <span class="accent">.NET</span>,<br />
          <span class="accent-cyan">Rust</span> y <span class="accent-cyan">Godot</span>.
        </h1>

        <div class="hero-terminal" aria-label="Línea de comando">
          <span class="prompt">$</span>
          <span class="cmd">whoami</span>
          <span class="text-text-muted">→</span>
          <span class="text-amber">fitty</span>
          <span class="text-text-muted">// dev · .net · rust · godot</span>
        </div>

        <p class="hero-subtitle">
          Desarrollo aplicaciones y herramientas. Mis proyectos están en
          producción con clientes reales y como productos propios. Te muestro
          el trabajo, no el currículum.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/pages/projects.html">
            Ver proyectos
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
          <a class="button button-ghost" href="/pages/contact.html">
            Hablemos de tu idea
          </a>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <span class="k">Enfoque</span>
            <span class="v">Software a medida</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Stack</span>
            <span class="v">.NET · Rust · Godot</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Comercial</span>
            <span class="v">Proyectos en producción</span>
          </div>
          <div class="hero-meta-item">
            <span class="k">Modalidad</span>
            <span class="v">Remoto · ES-AR / EN</span>
          </div>
        </div>
      </div>

      <!-- ===== Terminal card ===== -->
      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/fitty — status</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">fitty@dev</span>
            <span class="terminal-cmd">:~$ cat ./now.md</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">// <span class="text-cyan">en curso</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="text-success">Ecos del Obelisco</span> · godot 4, fase de diseño</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="text-success">PolyglotCLI</span> · .net 10, ocr local</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">· <span class="text-amber">Pairee</span> · rust tui, microsoft store</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">fitty@dev</span>
            <span class="terminal-cmd">:~$ ls ./en-producción/</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">
              pairee · polyglotcli · electroobra <span class="text-success">[cliente]</span> · flotahas <span class="text-success">[cliente]</span>
            </span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">fitty@dev</span>
            <span class="terminal-cmd">:~$<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== FEATURED -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Destacados</span>
        <h2 class="section-title">Los proyectos que mejor me representan.</h2>
        <p class="section-subtitle">
          Producto propio, código abierto, uso real. Estos son los que más
          disfruto construir.
        </p>
      </div>

      <div class="featured-grid">
        {featured.map((p, i) => (
          <a
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
            class="card card-feature reveal"
          >
            <div class="featured-head">
              <span class={`tag ${p.highlight === 'rust' ? 'tag-cyan' : 'tag-amber'}`}>
                {p.highlight}
              </span>
              <span class="text-text-dim" style="font-size: var(--text-xs); font-weight: 500;">
                0{i + 1} / 0{featured.length}
              </span>
            </div>
            <div class="featured-body">
              <div class="featured-icon" aria-hidden="true">
                {p.highlight === 'rust' ? '⌘' : '⟨/⟩'}
              </div>
              <ul class="featured-stack" aria-label="Stack del proyecto">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
            </div>
            <h3 class="featured-title">{p.title}</h3>
            <p class="featured-role">{p.role}</p>
            <p class="card-body">{p.desc}</p>
            <p class="card-body dim">{p.long}</p>
            <ul class="tag-list">
              {p.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <div class="card-footer">
              <span>{p.externalLabel ?? (p.external ? 'Ver en producción' : 'Leer más')}</span>
              <span class="card-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================== PROJECTS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Proyectos</span>
        <h2 class="section-title">Comerciales, productos propios y un juego en diseño.</h2>
        <p class="section-subtitle">
          Algunos viven en producción con clientes, otros son productos
          independientes. Todos tienen su historia.
        </p>
      </div>
      <div class="grid grid-2">
        {projects.map((p) => (
          p.href ? (
            <a href={p.href} class="card reveal">
              <div class="card-head-row">
                {p.status === 'comercial' && (
                  <span class="badge badge-success"><span class="dot" aria-hidden="true"></span>Comercial · en uso</span>
                )}
                {p.status === 'diseño' && (
                  <span class="badge badge-amber"><span class="dot" aria-hidden="true"></span>En diseño</span>
                )}
                {!p.status && (
                  <span class="text-text-muted" style="font-size: var(--text-xs);">→</span>
                )}
              </div>
              <h3 class="card-title">{p.title}</h3>
              <p class="featured-role" style="margin-top: -4px;">{p.role}</p>
              <p class="card-body">{p.desc}</p>
              <p class="card-body dim">{p.long}</p>
              <ul class="tag-list">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </a>
          ) : (
            <article class="card reveal" data-soon>
              <div class="card-head-row">
                {p.status === 'próximamente' && (
                  <span class="badge"><span class="dot" aria-hidden="true"></span>Próximamente</span>
                )}
                {p.status === 'diseño' && (
                  <span class="badge badge-amber"><span class="dot" aria-hidden="true"></span>En diseño</span>
                )}
                {!p.status && (
                  <span class="text-text-muted" style="font-size: var(--text-xs);">→</span>
                )}
              </div>
              <h3 class="card-title">{p.title}</h3>
              <p class="featured-role" style="margin-top: -4px;">{p.role}</p>
              <p class="card-body">{p.desc}</p>
              <p class="card-body dim">{p.long}</p>
              <ul class="tag-list">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </article>
          )
        ))}
      </div>
      <div class="inline-actions" style="margin-top: 2rem;">
        <a class="button button-ghost" href="/pages/projects.html">
          Ver todos los proyectos
          <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================================== FOCUS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">En qué trabajo</span>
        <h2 class="section-title">Cuatro líneas, una sola forma de hacer.</h2>
        <p class="section-subtitle">
          Software que se mantiene. Herramientas que se entienden. Juegos
          cuando es momento.
        </p>
      </div>
      <div class="grid grid-2">
        {focus.map((f, i) => (
          <article class="card card-feature reveal">
            <div class="card-head-row">
              <div class="card-icon" aria-hidden="true">{f.icon}</div>
              <span class="text-text-dim" style="font-size: var(--text-xs); font-weight: 500;">
                0{i + 1}
              </span>
            </div>
            <h3 class="card-title">{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================== CTA -->
  <section class="section">
    <div class="layout">
      <div class="cta reveal">
        <div class="cta-content">
          <span class="section-eyebrow">Próximo proyecto</span>
          <h2 class="cta-title">¿Tenés una idea que necesita código?</h2>
          <p class="section-subtitle">
            Software a medida en .NET, herramientas en Rust, o un prototipo de
            juego en Godot. Conversamos sin compromiso.
          </p>
          <div class="cta-actions">
            <a class="button button-primary" href="/pages/contact.html">
              Empezar conversación
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a class="button button-ghost" href="/pages/about.html">
              Sobre mí
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
