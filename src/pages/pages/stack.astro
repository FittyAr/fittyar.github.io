---
import Layout from '../../layouts/Layout.astro';

const languages = [
  { name: 'C# / .NET 8/9/10', level: 'experto', use: 'APIs, Blazor, desktop, mobile' },
  { name: 'Rust', level: 'activo', use: 'Tooling, CLIs, sistemas' },
  { name: 'GDScript', level: 'activo', use: 'Gameplay en Godot' },
  { name: 'TypeScript', level: 'intermedio', use: 'Web, tooling' },
  { name: 'Python', level: 'intermedio', use: 'Automatización, scripts' },
  { name: 'Java', level: 'intermedio', use: 'Backend empresarial' },
  { name: 'VB.NET', level: 'mantenimiento', use: 'Sistemas heredados' },
  { name: 'HTML / CSS / JS', level: 'sólido', use: 'Front, accesibilidad' },
] as const;

const frameworks = [
  { name: 'Blazor Server', use: 'Webapps reactivas en C#' },
  { name: '.NET MAUI', use: 'Mobile / desktop multiplataforma' },
  { name: 'Avalonia UI', use: 'Desktop cross-platform' },
  { name: 'Entity Framework Core', use: 'ORM con code-first' },
  { name: 'Godot 4.x', use: 'Game engine' },
  { name: 'Flet', use: 'UIs en Python' },
  { name: 'Microsoft.Extensions.AI', use: 'Abstracción para LLMs' },
  { name: 'Semantic Kernel', use: 'Orquestación de agentes' },
] as const;

const infrastructure = [
  { name: 'Proxmox VE', use: 'Virtualización on-prem' },
  { name: 'Debian 12', use: 'Servidor base' },
  { name: 'Zentyal', use: 'Active Directory / DNS' },
  { name: 'CachyOS', use: 'Workstation' },
  { name: 'Nginx', use: 'Reverse proxy + TLS' },
  { name: 'PostgreSQL', use: 'DB relacional prod' },
  { name: 'SQLite', use: 'Local-first / desktop' },
  { name: 'Docker', use: 'Contenedores' },
  { name: 'Cloudflare', use: 'DNS + DDoS' },
  { name: 'NIC.ar', use: 'Registro de dominios' },
  { name: 'Let\'s Encrypt', use: 'Certs automáticos' },
  { name: 'GitHub Actions', use: 'CI/CD' },
] as const;

const ai = [
  {
    title: 'Inferencia local',
    tools: ['ollama', 'llama.cpp', 'lm studio'],
    body: 'Despliegue y optimización de LLMs (DeepSeek R1, Gemma, Qwen) en entornos aislados para privacidad y baja latencia.',
  },
  {
    title: '.NET + AI',
    tools: ['.net ai', 'semantic kernel'],
    body: 'Integración nativa de modelos offline con abstracciones modernas en C#, conectando Ollama directo a la app.',
  },
  {
    title: 'Copilotos con rulesets',
    tools: ['cursor', 'copilot', 'rulesets'],
    body: 'Configuración de entornos con reglas globales para garantizar código limpio, modular y desacoplado.',
  },
] as const;

const toolchain = [
  { name: 'JetBrains Rider', use: 'IDE principal' },
  { name: 'Visual Studio', use: 'Proyectos .NET legacy' },
  { name: 'Neovim + LazyVim', use: 'Edición rápida' },
  { name: 'WezTerm', use: 'Terminal' },
  { name: 'Starship', use: 'Shell prompt' },
  { name: 'lazygit', use: 'TUI para git' },
  { name: 'btop', use: 'Monitoreo' },
  { name: 'k9s', use: 'Kubernetes TUI' },
] as const;
---

<Layout
  title="Stack | fitty.ar"
  description="Stack técnico de FittyAr: lenguajes, frameworks, infraestructura e IA local."
>
  <!-- ========================================== HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Stack
        </span>

        <h1 class="hero-title">
          Lo que uso, <span class="accent">en serio</span>.
        </h1>

        <div class="hero-terminal" aria-label="Resumen">
          <span class="prompt">$</span>
          <span class="cmd">cat stack.txt</span>
          <span class="muted">→</span>
          <span class="amber">.net · rust · godot · proxmox</span>
        </div>

        <p class="hero-subtitle">
          Un perfil técnico centrado en .NET, Rust, infraestructura propia y
          desarrollo de videojuegos en Godot. Sin buzzwords: herramientas
          probadas, no tendencias.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/pages/contact.html">
            Solicitar CV
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
          <a class="button button-ghost" href="/pages/projects.html">
            Ver proyectos
          </a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/stack/INDEX</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-out muted">$ tree ~/stack -L 2</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">languages/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">frameworks/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">infrastructure/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">ai/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">└── <span class="key">toolchain/</span></span>
          </div>
          <div class="terminal-line" style="margin-top: var(--s-3);">
            <span class="terminal-out muted">// actualizado: {new Date().getFullYear()}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== LANGUAGES -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Lenguajes</span>
        <h2 class="section-title">Lo que escribo día a día.</h2>
        <p class="section-subtitle">
          Con foco en performance, mantenimiento y escalabilidad.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-grid">
          {languages.map((l) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{l.name}</span>
              <span class="stack-item-meta">{l.level}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== FRAMEWORKS -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Frameworks</span>
        <h2 class="section-title">Lo que uso para construir.</h2>
        <p class="section-subtitle">
          Stack de trabajo para producto, backend y juegos.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-group-head">Frameworks & librerías</div>
        <div class="stack-grid">
          {frameworks.map((f) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{f.name}</span>
              <span class="stack-item-meta">{f.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== INFRASTRUCTURE -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Infraestructura</span>
        <h2 class="section-title">Operación real, en servidores propios.</h2>
        <p class="section-subtitle">
          Autonomía y control total del entorno. Sin hyperscalers, con criterio.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-group-head">Servidores & OS</div>
        <div class="stack-grid">
          {infrastructure.map((i) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{i.name}</span>
              <span class="stack-item-meta">{i.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== AI -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">IA Local</span>
        <h2 class="section-title">IA soberana, sin salir del laburo.</h2>
        <p class="section-subtitle">
          Modelos on-prem, integración nativa con .NET, copilotos con reglas.
        </p>
      </div>
      <div class="grid grid-3">
        {ai.map((a) => (
          <article class="card reveal">
            <ul class="tag-list" style="margin-bottom: var(--s-3);">
              {a.tools.map((t) => <li class="tag tag-cyan">{t}</li>)}
            </ul>
            <h3 class="card-title">{a.title}</h3>
            <p class="card-body">{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================== TOOLCHAIN -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Toolchain</span>
        <h2 class="section-title">Las herramientas del día a día.</h2>
        <p class="section-subtitle">
          Editores, terminales, prompts. La metafora shell-first se nota.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-grid">
          {toolchain.map((t) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{t.name}</span>
              <span class="stack-item-meta">{t.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== CTA -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <div class="cta-content">
          <span class="section-eyebrow">¿Algo en común?</span>
          <h2 class="cta-title">Si tu proyecto respira alguna de estas tecnologías, hablemos.</h2>
          <p class="section-subtitle">
            Una reunión de 30 min alcanza para saber si hay fit. Sin costo.
          </p>
          <div class="cta-actions">
            <a class="button button-primary" href="/pages/contact.html">
              Reservar 30 min
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
