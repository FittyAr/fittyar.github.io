---
import Layout from '../../layouts/Layout.astro';

const languages = [
  { name: 'C#', use: 'main' },
  { name: 'TypeScript', use: 'front, tooling' },
  { name: 'Rust', use: 'clis, sistemas' },
  { name: 'GDScript', use: 'godot, gameplay' },
  { name: 'Python', use: 'tools, scripts' },
  { name: 'SQL', use: 'sqlite, postgres' },
  { name: 'HTML / CSS', use: 'este portfolio' },
  { name: 'Bash / Shell', use: 'automatización' },
] as const;

const frameworks = [
  { name: '.NET 10', use: 'web, desktop, mobile, clis' },
  { name: 'Blazor Server', use: 'apps web reactivas en C#' },
  { name: 'ASP.NET Core', use: 'apis y servicios' },
  { name: '.NET MAUI', use: 'mobile y desktop multiplataforma' },
  { name: 'Avalonia UI', use: 'desktop cross-platform' },
  { name: 'Entity Framework Core', use: 'orm code-first' },
  { name: 'Godot 4', use: 'game engine' },
  { name: 'Ratatui', use: 'tuis en rust' },
  { name: 'Tokio', use: 'async runtime rust' },
  { name: 'Flet', use: 'uis en python' },
] as const;

const ai = [
  {
    title: 'Inferencia local',
    tools: ['ollama', 'llama.cpp', 'lm studio'],
    body: 'Modelos on-prem (DeepSeek, Gemma, Qwen) para visión, código y chat. Privacidad y baja latencia sin salir del equipo.',
  },
  {
    title: '.NET + AI',
    tools: ['.net ai', 'semantic kernel'],
    body: 'Integración nativa de modelos offline con Microsoft.Extensions.AI y Semantic Kernel, conectando Ollama a la app directamente.',
  },
  {
    title: 'Copilotos con rulesets',
    tools: ['cursor', 'copilot', 'rulesets'],
    body: 'Configuración de entornos con reglas globales estructuradas para código limpio, modular y desacoplado.',
  },
] as const;

const toolchainDev = [
  { name: 'Visual Studio', use: 'ide .net' },
  { name: 'Visual Studio Code', use: 'editor general' },
  { name: 'Android Studio', use: 'mobile' },
  { name: 'Zed', use: 'editor liviano' },
  { name: 'WSL2', use: 'linux en windows' },
  { name: 'PowerShell', use: 'shell windows' },
  { name: 'SSH', use: 'acceso remoto' },
  { name: 'curl', use: 'cli http' },
  { name: 'Git', use: 'versionado' },
  { name: 'GitHub CLI', use: 'prs, releases, gh' },
  { name: 'DBeaver', use: 'cliente sql' },
  { name: 'DataGrip', use: 'cliente sql jetbrains' },
  { name: 'pgAdmin', use: 'postgres web' },
  { name: 'DB Browser for SQLite', use: 'sqlite gui' },
  { name: 'Trello', use: 'gestión de proyectos' },
  { name: 'Astro', use: 'este sitio' },
  { name: 'GitHub Actions', use: 'ci/cd' },
] as const;

const toolchainServers = [
  { name: 'Hermes', use: 'agente ia' },
  { name: 'QwenPaw', use: 'agente ia' },
  { name: 'Docker', use: 'containers' },
  { name: 'Podman', use: 'containers rootless' },
  { name: 'Arcane', use: 'gestión containers' },
  { name: 'VMware', use: 'vms windows/linux' },
  { name: 'VirtualBox', use: 'vms testing' },
  { name: '1Panel', use: 'panel de servidores' },
  { name: 'Cockpit', use: 'gestión linux' },
] as const;

const environments = [
  { name: 'Windows', use: 'workstation principal' },
  { name: 'CachyOS', use: 'notebook' },
  { name: 'Fedora Server', use: 'homelab' },
  { name: 'Ubuntu Server', use: 'runtime para llama.cpp' },
  { name: 'Cloudflare', use: 'dns + ddos' },
  { name: 'NIC.ar', use: 'registro de dominios' },
] as const;
---

<Layout
  title="Stack | fitty.ar"
  description="Stack técnico: .NET, Rust, Godot, frameworks y herramientas de desarrollo."
>
  <!-- ========================================== HERO -->
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Stack
        </span>

        <h1 class="hero-title">
          Lo que uso, <span class="accent">en serio</span>.
        </h1>

        <div class="hero-terminal" aria-label="Resumen">
          <span class="prompt">$</span>
          <span class="cmd">cat stack.txt</span>
          <span class="text-text-muted">→</span>
          <span class="amber">.net · rust · godot</span>
        </div>

        <p class="hero-subtitle">
          Lenguajes, frameworks y herramientas con los que trabajo día a día.
          Sin buzzwords, sin incluir cosas que probé un domingo. Esto es lo que
          hay en el código.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/pages/contact.html">
            Hablemos
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
          <a class="button button-ghost" href="/pages/projects.html">
            Ver proyectos
          </a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/stack/INDEX</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-out muted">$ tree ~/stack -L 2</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">languages/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">frameworks/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">ai/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">toolchain/</span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">└── <span class="key">environments/</span></span>
          </div>
          <div class="terminal-line" style="margin-top: var(--s-3);">
            <span class="terminal-out muted">// actualizado: {new Date().getFullYear()}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== LANGUAGES -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Lenguajes</span>
        <h2 class="section-title">Lo que escribo día a día.</h2>
        <p class="section-subtitle">
          Con foco en mantenibilidad y proyectos que se terminan.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-grid">
          {languages.map((l) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{l.name}</span>
              <span class="stack-item-meta">{l.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== FRAMEWORKS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Frameworks</span>
        <h2 class="section-title">Lo que uso para construir.</h2>
        <p class="section-subtitle">
          Stack de trabajo para producto, tooling y prototipos.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-group-head">Frameworks & librerías</div>
        <div class="stack-grid">
          {frameworks.map((f) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{f.name}</span>
              <span class="stack-item-meta">{f.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== AI -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">IA Local</span>
        <h2 class="section-title">Modelos on-prem, sin salir del equipo.</h2>
        <p class="section-subtitle">
          Inferencia local, integración con .NET, copilotos con rulesets.
        </p>
      </div>
      <div class="grid grid-3">
        {ai.map((a) => (
          <article class="card reveal">
            <ul class="tag-list" style="margin-bottom: var(--s-3);">
              {a.tools.map((t) => <li class="tag tag-cyan">{t}</li>)}
            </ul>
            <h3 class="card-title">{a.title}</h3>
            <p class="card-body">{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================== TOOLCHAIN -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Toolchain</span>
        <h2 class="section-title">Workstation y work server.</h2>
        <p class="section-subtitle">
          IDE, terminal, DB, deploy en la workstation. Containers, VMs y
          agentes IA en el work server.
        </p>
      </div>
      <div class="stack-group reveal">
        <div class="stack-group-head">Workstation</div>
        <div class="stack-grid">
          {toolchainDev.map((t) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{t.name}</span>
              <span class="stack-item-meta">{t.use}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="stack-group reveal" style="margin-top: var(--s-10);">
        <div class="stack-group-head">Work server</div>
        <div class="stack-grid">
          {toolchainServers.map((t) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{t.name}</span>
              <span class="stack-item-meta">{t.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== ENVIRONMENTS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Entornos</span>
        <h2 class="section-title">Dónde corre el código.</h2>
        <p class="section-subtitle">
          Workstation y servidores para dev. Sin servicios de terceros
          innecesarios.
        </p>
      </div>
      <div class="stack-group">
        <div class="stack-grid">
          {environments.map((e) => (
            <div class="stack-item">
              <span class="stack-item-dot"></span>
              <span class="stack-item-name">{e.name}</span>
              <span class="stack-item-meta">{e.use}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== CTA -->
  <section class="section">
    <div class="layout">
      <div class="cta reveal">
        <div class="cta-content">
          <span class="section-eyebrow">¿Algo en común?</span>
          <h2 class="cta-title">Si tu proyecto respira alguna de estas tecnologías, hablemos.</h2>
          <p class="section-subtitle">
            Una reunión de 30 min alcanza para saber si hay fit. Sin costo.
          </p>
          <div class="cta-actions">
            <a class="button button-primary" href="/pages/contact.html">
              Reservar 30 min
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
