---
import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    title: 'Pairee',
    role: 'File manager TUI en Rust',
    category: 'rust',
    categoryLabel: 'rust',
    desc: 'Gestor de archivos dual-panel para terminal, rápido y moderno.',
    long: 'Construido con Rust, Ratatui y Tokio. Event loop asíncrono, keybindings personalizables y vista previa de archivos.',
    tags: ['rust', 'ratatui', 'tokio', 'tui'],
    href: 'https://pairee.fitty.ar',
    external: true,
    status: 'producto',
  },
  {
    title: 'PolyglotCLI',
    role: 'Traductor de PDFs en .NET 10',
    category: 'dotnet',
    categoryLabel: '.net 10',
    desc: 'Traducción incremental de PDFs con OCR con modelos de visión locales.',
    long: '.NET 10 y C#. Procesa página por página para no reventar la RAM. Compatible con LM Studio y Ollama para OCR.',
    tags: ['.net 10', 'csharp', 'ocr', 'llm local'],
    href: '/pages/polyglot-cli.html',
    status: 'producto',
  },
  {
    title: 'ElectroObra',
    role: 'Gestión operativa para construcción',
    category: 'dotnet',
    categoryLabel: 'comercial',
    desc: 'Sistema de gestión y flujo de caja para pymes de construcción y mantenimiento.',
    long: 'Multiplataforma con Avalonia UI y SQLite, Clean Architecture. Producto comercial en uso.',
    tags: ['.net 10', 'avalonia', 'sqlite', 'clean arch'],
    href: '/pages/electro-obra.html',
    status: 'comercial',
  },
  {
    title: 'Flota-HAS',
    role: 'Gestión de flotas ride-hailing',
    category: 'dotnet',
    categoryLabel: 'comercial',
    desc: 'Aplicación multiplataforma para control de flotas, choferes y recaudación.',
    long: 'Local-first con .NET MAUI, EF Core y SQLite. Funciona sin servidor. Producto comercial en uso.',
    tags: ['.net maui', 'ef core', 'sqlite', 'local-first'],
    href: '/pages/flota-has.html',
    status: 'comercial',
  },
  {
    title: 'Cardfile',
    role: 'Gestor de tarjetas multiplataforma',
    category: 'python',
    categoryLabel: 'python',
    desc: 'Organizador de tarjetas y notas con estética retro Windows 3.1.',
    long: 'Python + Flet. Multiidioma, base relacional, look CRT.',
    tags: ['python', 'flet', 'markdown'],
    href: '/pages/cardfile.html',
    status: 'producto',
  },
  {
    title: 'Ecos del Obelisco',
    role: 'Videojuego en Godot',
    category: 'godot',
    categoryLabel: 'game dev',
    desc: 'Narrativas inmersivas y mecánicas diseñadas desde cero.',
    long: 'Godot 4 + GDScript. Iteración constante, actualmente en fase de diseño.',
    tags: ['godot 4', 'gdscript', 'narrativa'],
    href: '/pages/ecos-del-obelisco.html',
    status: 'diseño',
  },
  {
    title: 'Catálogo Techparts',
    role: 'Catálogo comercial (legacy)',
    category: 'legacy',
    categoryLabel: 'comercial',
    desc: 'Mi primer proyecto comercial. Sistema de catálogo de productos para comercio de repuestos, vendido y puesto en producción.',
    long: 'Desarrollado hace varios años. Actualmente deprecado: el cliente ya opera un sistema más grande. Próximamente agrego fotos y contexto.',
    tags: ['legacy', 'comercial'],
    status: 'próximamente',
  },
] as const;

const categories = [
  { id: 'all', label: 'Todos', count: projects.length },
  { id: 'producto', label: 'Producto propio', count: projects.filter((p) => p.status === 'producto').length },
  { id: 'comercial', label: 'Comercial · en uso', count: projects.filter((p) => p.status === 'comercial').length },
  { id: 'diseño', label: 'En diseño', count: projects.filter((p) => p.status === 'diseño').length },
];
---

<Layout
  title="Proyectos | fitty.ar"
  description="Software a medida en .NET, herramientas en Rust y juegos en Godot. Productos propios y proyectos comerciales en producción."
>
  <!-- ========================================== HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Proyectos
        </span>

        <h1 class="hero-title">
          Software a medida, <span class="accent">productos</span><br />
          y <span class="accent-cyan">juegos</span> en producción.
        </h1>

        <div class="hero-terminal" aria-label="Resumen">
          <span class="prompt">$</span>
          <span class="cmd">ls ~/projects/</span>
          <span class="text-text-muted">→</span>
          <span class="amber">{projects.length} items</span>
        </div>

        <p class="hero-subtitle">
          Productos propios, proyectos comerciales en producción, y un juego
          en diseño. Cada uno con su historia técnica.
        </p>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/projects/ --tree</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-out muted">~/projects</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">producto-propio/</span> (3)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">comercial/</span> (2)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">├── <span class="key">diseño/</span> (1)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out">└── <span class="key">legacy/</span> (1)</span>
          </div>
          <div class="terminal-line" style="margin-top: var(--s-3);">
            <span class="terminal-out muted">// todos con código y contexto público.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== FILTERS (visual) -->
  <section class="section" style="padding-top: var(--s-8);">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-eyebrow">Selección</span>
        <h2 class="section-title">Todo lo que está vivo.</h2>
        <p class="section-subtitle">
          Producto propio, comercial en uso, en diseño, y legacy. Filtrá
          mentalmente o andá directo a lo que te interese.
        </p>
      </div>

      <div class="inline-actions reveal" style="margin-bottom: var(--s-8); flex-wrap: wrap;">
        {categories.map((c) => (
          <span class={`tag ${c.id === 'all' ? 'tag-amber' : ''}`} style="padding: 6px 12px; font-size: var(--fs-xs);">
            {c.label} <span class="text-text-muted">·</span> {c.count}
          </span>
        ))}
      </div>

      <div class="grid grid-2">
        {projects.map((p) => (
          p.href ? (
            <a
              href={p.href}
              target={p.external ? '_blank' : undefined}
              rel={p.external ? 'noopener noreferrer' : undefined}
              class="card reveal"
            >
              <div class="card-head-row">
                {p.status === 'comercial' && (
                  <span class="badge badge-success"><span class="dot" aria-hidden="true"></span>Comercial · en uso</span>
                )}
                {p.status === 'producto' && (
                  <span class="badge badge-amber"><span class="dot" aria-hidden="true"></span>Producto propio</span>
                )}
                {p.status === 'diseño' && (
                  <span class="badge"><span class="dot" aria-hidden="true"></span>En diseño</span>
                )}
                {!p.status && (
                  <span class="text-text-muted" style="font-size: var(--fs-xs);">→</span>
                )}
                <span class="text-text-muted" style="font-size: var(--fs-xs);">
                  {p.external ? '↗ externo' : '→'}
                </span>
              </div>
              <h3 class="card-title">{p.title}</h3>
              <p class="featured-role" style="margin-top: -4px;">{p.role}</p>
              <p class="card-body">{p.desc}</p>
              <p class="card-body dim" style="font-size: var(--fs-xs);">{p.long}</p>
              <ul class="tag-list">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </a>
          ) : (
            <article class="card reveal" data-soon>
              <div class="card-head-row">
                {p.status === 'próximamente' && (
                  <span class="badge"><span class="dot" aria-hidden="true"></span>Próximamente</span>
                )}
              </div>
              <h3 class="card-title">{p.title}</h3>
              <p class="featured-role" style="margin-top: -4px;">{p.role}</p>
              <p class="card-body">{p.desc}</p>
              <p class="card-body dim" style="font-size: var(--fs-xs);">{p.long}</p>
              <ul class="tag-list">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================== SERVICES -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="section-eyebrow">Servicios</span>
          <h2 class="section-title" style="margin-top: var(--s-3);">Qué puedo hacer por tu proyecto.</h2>
          <p class="section-subtitle" style="margin-top: var(--s-4);">
            Si necesitás software a medida, una herramienta interna, o un
            prototipo de juego, podemos conversar el alcance y los tiempos.
          </p>
          <div class="inline-actions" style="margin-top: var(--s-6);">
            <a class="button button-primary" href="/pages/contact.html">
              Iniciar conversación
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a class="button button-ghost" href="/pages/about.html">
              Sobre mí
            </a>
          </div>
        </div>

        <div class="terminal reveal">
          <div class="terminal-header">
            <span class="terminal-dots" aria-hidden="true">
              <span class="terminal-dot r"></span>
              <span class="terminal-dot y"></span>
              <span class="terminal-dot g"></span>
            </span>
            <span class="terminal-title">~/services/scope.md</span>
            <span style="width: 36px;" aria-hidden="true"></span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="terminal-out muted">## tipos de proyecto</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="key">app a medida</span> · web, desktop, mobile</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="key">cli / tooling</span> · rust o .net</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="key">migración</span> de sistemas existentes</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="key">integración</span> con ia local / apis</span>
            </div>
            <div class="terminal-line" style="margin-top: var(--s-3);">
              <span class="terminal-out muted">## modalidad</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="ok">remoto</span>, async-first</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="ok">reunión inicial</span> sin costo</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-out">· <span class="ok">honorarios</span> por proyecto o retainer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
