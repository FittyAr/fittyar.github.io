---
import Layout from '../../layouts/Layout.astro';
import ScreenshotPlaceholder from '../../components/ScreenshotPlaceholder.astro';
---

<Layout
  title="fitty.ar | Ecos del Obelisco"
  description="Detalles del videojuego Ecos del Obelisco"
>
  <section class="hero">
    <div class="layout">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Videojuego en desarrollo
        </span>

        <h1 class="hero-title">Ecos del Obelisco</h1>

        <p class="hero-subtitle">
          Un videojuego de misterio y exploración atmosférica diseñado y
          programado en Godot Engine.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================== CAPTURAS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Capturas</span>
        <h2 class="section-title">Avance visual.</h2>
        <p class="section-subtitle">Concept art, moodboard y capturas de mecánicas durante la fase de diseño.</p>
      </div>
      <div class="grid grid-2">
        <ScreenshotPlaceholder
          label="Concept art principal"
          path="/assets/images/projects/ecos-del-obelisco/01-concept.png"
          alt="Concept art principal de Ecos del Obelisco"
          aspect="4/3"
        />
        <ScreenshotPlaceholder
          label="Moodboard · atmósfera"
          path="/assets/images/projects/ecos-del-obelisco/02-moodboard.png"
          alt="Moodboard de atmósfera de Ecos del Obelisco"
          aspect="4/3"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout layout-narrow">
      <div class="prose reveal">
        <h2>Ficha técnica</h2>
        <p>
          Esta página contendrá el detalle del desarrollo, mecánicas y arte del
          juego. El proyecto está actualmente en fase de diseño e iteración de
          mecánicas antes de empezar producción.
        </p>
        <p>
          Mientras tanto, podés seguir el avance en GitHub o contactarme para
          saber más.
        </p>
        <h2>Stack</h2>
        <ul>
          <li>Godot 4 + GDScript</li>
          <li>Diseño de mecánicas y narrativa</li>
          <li>Pixel art y moodboard en progreso</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
