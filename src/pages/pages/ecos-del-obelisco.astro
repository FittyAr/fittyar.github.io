---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="fitty.ar | Ecos del Obelisco"
  description="Detalles del videojuego Ecos del Obelisco"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Videojuego en Desarrollo</span>
      <h1 class="hero-title">Ecos del Obelisco</h1>
      <p class="hero-subtitle">
        Un videojuego de misterio y exploración atmosférica diseñado y
        programado en Godot Engine.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Ficha Técnica</h2>
      <p>Esta página contendrá el detalle del desarrollo, mecánicas y arte del juego.</p>
    </div>
  </section>
</Layout>
