---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/catalogo-techparts';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = c.meta.title;
const description = c.meta.description;

const techpartsImages = [
  'catalogo-techparts/01.png',
  'catalogo-techparts/02.png',
  'catalogo-techparts/prototipo-rediseno.jpg',
  'catalogo-techparts/03.png',
  'catalogo-techparts/04.png',
];
---

<Layout title={title} description={description} ogImage="catalogo-techparts/01.png">
    <section class="hero">
        <div class="layout hero-grid">
            <div class="reveal">
                <span class="hero-eyebrow">
                    <span class="dot" aria-hidden="true"></span>
                    {c.hero.eyebrow}
                </span>

                <h1 class="hero-title">{c.hero.title}</h1>

                <p class="hero-subtitle">
                  {c.hero.subtitle}
                </p>
            </div>

            <div class="terminal reveal">
                <div class="terminal-header">
                    <span class="terminal-dots" aria-hidden="true">
                        <span class="terminal-dot r"></span>
                        <span class="terminal-dot y"></span>
                        <span class="terminal-dot g"></span>
                    </span>
                    <span class="terminal-title">~/techparts/stack</span>
                    <span style="width: 36px;" aria-hidden="true"></span>
                </div>
                <div class="terminal-body">
                    <div class="terminal-line">
                        <span class="terminal-prompt">$</span>
                        <span class="terminal-cmd">cat stack.yaml</span>
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"><span class="text-cyan">platform</span>: Windows .NET</span>
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"><span class="text-cyan">db</span>: SQLite</span>
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"><span class="text-cyan">mode</span>: offline-first</span>
                    </div>
                    <div class="terminal-line" style="margin-top: 1.25rem;">
                        <span class="terminal-prompt">$</span>
                        <span class="terminal-cmd">catalog --legacy<span class="cursor" aria-hidden="true"></span></span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{c.context.eyebrow}</span>
                <h2 class="section-title">{c.context.title}</h2>
                <p class="section-subtitle">
                  {c.context.subtitle}
                </p>
            </div>

            <div class="grid grid-3">
                {c.context.items.map((item) => (
                    <article class="card reveal">
                        <h3 class="card-title">{item.title}</h3>
                        <p class="card-body">
                          {item.body}
                        </p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{c.sync.eyebrow}</span>
                <h2 class="section-title">{c.sync.title}</h2>
                <p class="section-subtitle">
                  {c.sync.subtitle}
                </p>
            </div>

            <div class="prose reveal">
              {c.sync.paragraphs.map((p) => <p>{p}</p>)}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{c.pipeline.eyebrow}</span>
                <h2 class="section-title">{c.pipeline.title}</h2>
                <p class="section-subtitle">
                  {c.pipeline.subtitle}
                </p>
            </div>

            <div class="prose reveal">
              {c.pipeline.paragraphs.map((p) => <p>{p}</p>)}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
                <h2 class="section-title">{c.screenshots.title}</h2>
                <p class="section-subtitle">
                  {c.screenshots.subtitle}
                </p>
            </div>

            <div>
                <Carousel images={techpartsImages} label={c.screenshots.carouselLabel} />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout layout-narrow">
            <div
                class="section-header reveal center"
                style="margin-inline: auto; text-align: center;"
            >
                <span class="section-eyebrow">{c.status.eyebrow}</span>
                <h2 class="section-title">Legacy.</h2>
                <p class="section-subtitle" style="margin-inline: auto;">
                  {c.status.body}
                </p>
            </div>
        </div>
    </section>
</Layout>
