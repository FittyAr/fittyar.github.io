---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/certaro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = `fitty.ar | ${c.name}`;
const description = c.meta.description;

// Current version screenshots (Rust + Tauri)
const certaroImages = [
  'certaro/10.png',
  'certaro/11.png',
  'certaro/12.png',
  'certaro/13.png',
];

---

<Layout title={title} description={description} ogImage="certaro/10.png">
  <!-- Hero -->
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          {c.hero.eyebrow}
        </span>

        <h1 class="hero-title">{c.name}</h1>

        <p class="hero-subtitle">
          <Fragment set:html={c.hero.subtitle} />
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href={`/${locale}/pages/projects.html`}>{t('project_detail.otros_proyectos')}</a>
          <a class="button button-ghost" href={`/${locale}/pages/contact.html`}>{t('chrome.nav.contact')}</a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/certaro/stack</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">cat stack.yaml</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">core</span>: Rust + Tauri 2.x</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ui</span>: Tauri WebView (native frontend)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">db</span>: SQLite (offline-first)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">arch</span>: Clean Architecture</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">license</span>: {c.terminal.license}</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">roadmap</span>: {c.terminal.roadmap}</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">certaro --status<span class="cursor" aria-hidden="true"></span></span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out" style="opacity: 0.6; font-size: 0.8em;">
              {c.terminal.status}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Evolución -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{c.evolution.eyebrow}</span>
        <h2 class="section-title">{c.evolution.title}</h2>
        <p class="section-subtitle">
          {c.evolution.subtitle}
        </p>
      </div>

      <div class="evo-wrap reveal">
        <div class="evo-rail" aria-hidden="true">
          <span class="evo-rail-dot is-origin"></span>
          <span class="evo-rail-line"></span>
          <span class="evo-rail-dot is-rewrite"></span>
          <span class="evo-rail-line"></span>
          <span class="evo-rail-dot is-present"></span>
        </div>

        <div class="evo-grid">
          <article class="evo-card evo-card--origin">
            <div class="evo-head">
              <span class="evo-num">01</span>
              <span class="evo-label">{c.evolution.origin.label}</span>
              <span class="evo-year">2023 — 2025</span>
            </div>
            <h3 class="evo-title">ElectroObra</h3>
            <p class="evo-meta">Avalonia UI · .NET 10 · SQLite · Clean Architecture</p>
            <p class="evo-body">
              {c.evolution.origin.body}
            </p>
            <ul class="evo-tags" aria-label="stack">
              <li>avalonia</li><li>.net 10</li><li>ef core</li>
            </ul>
          </article>

          <article class="evo-card evo-card--rewrite">
            <div class="evo-head">
              <span class="evo-num">02</span>
              <span class="evo-label">{c.evolution.rewrite.label}</span>
              <span class="evo-badge">{c.evolution.rewrite.badge}</span>
            </div>
            <h3 class="evo-title">Rust + Tauri</h3>
            <p class="evo-meta">Tauri 2.x · Rust · SQLite offline-first</p>
            <p class="evo-body">
              {c.evolution.rewrite.body}
            </p>
            <ul class="evo-tags" aria-label="stack">
              <li>rust</li><li>tauri</li><li>sqlite</li>
            </ul>
          </article>

          <article class="evo-card evo-card--present">
            <div class="evo-head">
              <span class="evo-num">03</span>
              <span class="evo-label">{c.evolution.present.label}</span>
              <span class="evo-year">2026 →</span>
            </div>
            <h3 class="evo-title">{c.name}</h3>
            <p class="evo-meta">{c.evolution.present.meta}</p>
            <p class="evo-body">
              {c.evolution.present.body}
            </p>
            <ul class="evo-tags" aria-label="model">
              <li>{c.evolution.present.tagCommercial}</li><li>ERP</li><li>CRM</li>
            </ul>
          </article>
        </div>

        <div class="evo-bridge">
          <div class="evo-bridge-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v3"/><path d="M6 9v3a2 2 0 0 0 2 2h3"/></svg>
          </div>
          <div class="evo-bridge-content">
            <h4 class="evo-bridge-title">{c.evolution.bridge.title}</h4>
            <p class="evo-bridge-body">
              <Fragment set:html={c.evolution.bridge.body} />
            </p>
          </div>
          <div class="evo-bridge-flow" aria-hidden="true">
            <span class="evo-flow-node is-fork">ElectroObra</span>
            <span class="evo-flow-arrow">→</span>
            <span class="evo-flow-node is-upstream">{c.name}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .evo-wrap { display: grid; gap: 1.25rem; }
    .evo-rail {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding-inline: 0.5rem;
    }
    .evo-rail-dot {
      width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
      border: 2px solid var(--color-border-strong);
      background: var(--color-raised);
      box-shadow: 0 0 0 4px var(--color-base);
    }
    .evo-rail-dot.is-origin { border-color: var(--color-text-dim); }
    .evo-rail-dot.is-rewrite { border-color: var(--color-amber); background: var(--color-amber); box-shadow: 0 0 0 4px var(--color-amber-soft), 0 0 12px rgba(255,184,108,0.5); }
    .evo-rail-dot.is-present { border-color: var(--color-cyan); }
    .evo-rail-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--color-border), var(--color-border-strong)); }

    .evo-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      align-items: stretch;
    }
    .evo-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.5rem;
      background: var(--color-raised);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      position: relative;
      overflow: hidden;
      isolation: isolate;
      min-width: 0;
    }
    .evo-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--evo-accent, var(--color-border-strong));
      opacity: 0.9;
    }
    .evo-card--origin { --evo-accent: var(--color-text-dim); }
    .evo-card--rewrite { --evo-accent: var(--color-amber); }
    .evo-card--present { --evo-accent: var(--color-cyan); }
    .evo-card--rewrite { border-color: var(--color-border-amber); box-shadow: 0 8px 32px -16px rgba(255,184,108,0.35); }

    .evo-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      min-width: 0;
    }
    .evo-num {
      display: inline-grid;
      place-items: center;
      min-width: 2rem;
      height: 1.5rem;
      padding-inline: 0.4rem;
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--color-text);
      background: var(--color-inset);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      line-height: 1;
    }
    .evo-card--rewrite .evo-num { color: var(--color-amber); border-color: var(--color-border-amber); background: var(--color-amber-soft); }
    .evo-label {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .evo-year {
      margin-left: auto;
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--color-text-dim);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .evo-badge {
      margin-left: auto;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-amber);
      background: var(--color-amber-soft);
      border: 1px solid var(--color-border-amber);
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .evo-title {
      margin: 0;
      font-size: var(--text-lg);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--color-text);
      overflow-wrap: normal;
      word-break: normal;
      text-wrap: balance;
      display: block;
    }

    .evo-meta {
      margin: 0;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      line-height: 1.5;
      overflow-wrap: normal;
      word-break: normal;
    }

    .evo-body {
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.65;
      color: var(--color-text-muted);
      overflow-wrap: break-word;
    }

    .evo-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      list-style: none;
      margin: auto 0 0;
      padding: 0;
      padding-top: 0.75rem;
      border-top: 1px dashed var(--color-border);
    }
    .evo-tags li {
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-dim);
      background: var(--color-inset);
      border: 1px solid var(--color-border);
      padding: 0.2rem 0.45rem;
      border-radius: var(--radius-sm);
      line-height: 1;
    }
    .evo-card--rewrite .evo-tags li { border-color: var(--color-border-amber); color: var(--color-text-muted); }

    .evo-bridge {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 1rem;
      align-items: center;
      padding: 1.1rem 1.25rem;
      background: linear-gradient(180deg, var(--color-raised), var(--color-soft));
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--color-amber);
      border-radius: var(--radius-lg);
    }
    .evo-bridge-icon {
      width: 36px; height: 36px;
      display: grid; place-items: center;
      background: var(--color-amber-soft);
      border: 1px solid var(--color-border-amber);
      border-radius: var(--radius-sm);
      color: var(--color-amber);
      flex-shrink: 0;
    }
    .evo-bridge-content { min-width: 0; }
    .evo-bridge-title {
      margin: 0 0 0.25rem;
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--color-text);
      letter-spacing: -0.01em;
    }
    .evo-bridge-body {
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.6;
      color: var(--color-text-muted);
    }
    .evo-bridge-body strong { color: var(--color-text); font-weight: 700; }
    .evo-bridge-flow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: var(--color-inset);
      border: 1px solid var(--color-border);
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .evo-flow-node {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .evo-flow-node.is-upstream { color: var(--color-text); }
    .evo-flow-node.is-fork { color: var(--color-text-muted); }
    .evo-flow-arrow { color: var(--color-amber); font-weight: 800; }

    @media (min-width: 901px) {
      .evo-rail { display: flex; }
    }
    @media (max-width: 900px) {
      .evo-grid { grid-template-columns: 1fr; }
      .evo-bridge { grid-template-columns: auto 1fr; }
      .evo-bridge-flow { grid-column: 1 / -1; justify-self: start; }
    }
    @media (max-width: 560px) {
      .evo-card { padding: 1.25rem; }
      .evo-bridge { padding: 1rem; }
    }
  </style>

  <!-- Capturas — versión actual (Tauri) -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{c.screenshots.eyebrow}</span>
        <h2 class="section-title">{c.screenshots.title}</h2>
        <p class="section-subtitle">
          {c.screenshots.subtitle}
        </p>
      </div>
      <div>
        <Carousel images={certaroImages} label={`${c.name} — Rust + Tauri`} />
      </div>
    </div>
  </section>

  <!-- Predecesor: ElectroObra (página propia, menor) -->
  <section class="section" style="padding-top: 0;">
    <div class="layout">
      <p class="section-subtitle reveal">
        {c.screenshots.archive.before}<a href={`/${locale}/pages/electro-obra.html`}>{c.screenshots.archive.link}</a>{c.screenshots.archive.after}
      </p>
    </div>
  </section>

  <!-- Filosofía -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{c.philosophy.eyebrow}</span>
        <h2 class="section-title">{c.philosophy.title}</h2>
        <p class="section-subtitle">
          {c.philosophy.subtitle}
        </p>
      </div>
      <div class="grid grid-3">
        {c.philosophy.items.map((item) => (
          <article class="card reveal">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-body">
              {item.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Arquitectura -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Clean Architecture</span>
        <h2 class="section-title">{c.architecture.title}</h2>
        <p class="section-subtitle">
          {c.architecture.subtitle}
        </p>
      </div>
      <div class="grid grid-3">
        {c.architecture.layers.map((layer) => (
          <article class="card reveal">
            <h3 class="card-title">{layer.title}</h3>
            <p class="card-body">
              {layer.body}
            </p>
          </article>
        ))}
      </div>
      <div style="margin-top: 1.5rem;" class="grid grid-3">
        <article class="card reveal">
          <h3 class="card-title">{c.architecture.ui.title}</h3>
          <p class="card-body">
            {c.architecture.ui.body}
          </p>
        </article>
        <article class="card reveal" style="border-style: dashed;">
          <h3 class="card-title">{c.architecture.changes.title}</h3>
          <p class="card-body">
            {c.architecture.changes.body}
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
