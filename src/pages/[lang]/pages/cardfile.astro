---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/cardfile';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = 'fitty.ar | Cardfile';
const description = c.meta.description;

const cardfileImages = [
  'cardfile/01.png',
];
---

<Layout title={title} description={description} ogImage="cardfile/01.png">
    <section class="hero">
        <div class="layout hero-grid">
            <div class="reveal">
                <span class="hero-eyebrow">
                    <span class="dot" aria-hidden="true"></span>
                    {c.hero.eyebrow}
                </span>

                <h1 class="hero-title">Cardfile</h1>

                <p class="hero-subtitle">
                  {c.hero.subtitle}
                </p>

                <div class="hero-actions">
                    <a
                        class="button button-primary"
                        href="https://github.com/FittyAr/Cardfile"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t('project_detail.ver_codigo')}
                        <svg
                            class="button-icon"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path
                                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                            ></path>
                        </svg>
                    </a>
                    <a class="button button-ghost" href={`/${locale}/pages/projects.html`}>
                      {t('project_detail.otros_proyectos')}
                    </a>
                </div>
            </div>

            <div class="terminal reveal">
                <div class="terminal-header">
                    <span class="terminal-dots" aria-hidden="true">
                        <span class="terminal-dot r"></span>
                        <span class="terminal-dot y"></span>
                        <span class="terminal-dot g"></span>
                    </span>
                    <span class="terminal-title">~/cardfile/stack</span>
                    <span style="width: 36px;" aria-hidden="true"></span>
                </div>
                <div class="terminal-body">
                    <div class="terminal-line">
                        <span class="terminal-prompt">$</span>
                        <span class="terminal-cmd">cat stack.yaml</span>
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"
                            ><span class="text-cyan">platform</span>: Python
                            3.10+ &amp; Docker</span
                        >
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"
                            ><span class="text-cyan">ui</span>: Flet 1.0 Beta
                            (Flutter for Python)</span
                        >
                    </div>
                    <div class="terminal-line">
                        <span class="terminal-out"
                            ><span class="text-cyan">i18n</span>: {c.hero.stackI18n}</span
                        >
                    </div>
                    <div class="terminal-line" style="margin-top: 1.25rem;">
                        <span class="terminal-prompt">$</span>
                        <span class="terminal-cmd"
                            >cardfile --open<span
                                class="cursor"
                                aria-hidden="true"></span></span
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== CAPTURAS -->
    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
                <h2 class="section-title">{c.screenshots.title}</h2>
                <p class="section-subtitle">
                  {c.screenshots.subtitle}
                </p>
            </div>
            <div>
                <Carousel images={cardfileImages} label="Cardfile" />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{t('project_detail.caracteristicas_eyebrow')}</span>
                <h2 class="section-title">{c.features.title}</h2>
                <p class="section-subtitle">
                  {c.features.subtitle}
                </p>
            </div>
            <div class="grid grid-3">
                {c.features.items.map((f) => (
                    <article class="card reveal">
                        <h3 class="card-title">{f.title}</h3>
                        <p class="card-body">
                          {f.body}
                        </p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{c.advanced.eyebrow}</span>
                <h2 class="section-title">{c.advanced.title}</h2>
                <p class="section-subtitle">
                  {c.advanced.subtitle}
                </p>
            </div>
            <div class="grid grid-3">
                {c.advanced.items.map((f) => (
                    <article class="card reveal">
                        <h3 class="card-title">{f.title}</h3>
                        <p class="card-body">
                          {f.body}
                        </p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="layout">
            <div class="section-header reveal">
                <span class="section-eyebrow">{c.install.eyebrow}</span>
                <h2 class="section-title">{c.install.title}</h2>
                <p class="section-subtitle">
                  {c.install.subtitle}
                </p>
            </div>

            <div class="prose reveal">
                <h3>{c.install.local.title}</h3>
                <p>{c.install.local.intro}</p>

                <p><strong>Linux / macOS:</strong></p>
                <CodeBlock label={c.install.local.copyLabelUnix}>{`python -m venv venv
source venv/bin/activate
pip install --upgrade pip
pip install -r requirements.txt
python main.py`}</CodeBlock>

                <p><strong>Windows (PowerShell):</strong></p>
                <CodeBlock label={c.install.local.copyLabelWindows}>{`python -m venv venv
.\\venv\\Scripts\\activate
pip install --upgrade pip
pip install -r requirements.txt
python main.py`}</CodeBlock>

                <h3>{c.install.docker.title}</h3>
                <p>{c.install.docker.intro}</p>
                <CodeBlock label={c.install.docker.copyLabel}>{`cd docker
docker compose up --build`}</CodeBlock>
                <p set:html={c.install.docker.outro} />
            </div>
        </div>
    </section>
</Layout>
