---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/polyglot-cli';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = c.meta.title;
const description = c.meta.description;

const polyglotImages = [
  'polyglot-cli/01.png',
  'polyglot-cli/02.png',
  'polyglot-cli/03.png',
  'polyglot-cli/04.png',
  'polyglot-cli/05.png',
];

const eyebrow = t('project_detail.open_source_eyebrow');
---

<Layout title={title} description={description} ogImage="polyglot-cli/01.png">
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          {eyebrow}
        </span>

        <h1 class="hero-title">PolyglotCLI</h1>

        <p class="hero-subtitle">
          {c.hero.subtitle}
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/FittyAr/PolyglotCLI" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_codigo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a class="button button-ghost" href={`/${locale}/pages/projects.html`}>{t('project_detail.otros_proyectos')}</a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/polyglotcli/stack</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">cat stack.yaml</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">platform</span>: .NET 10 SDK &amp; C#</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ai</span>: LM Studio (Local LLM/Vision API)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">libs</span>: PdfPig, PDFtoImage, SkiaSharp</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">polyglot --help<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== CAPTURAS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
        <h2 class="section-title">{c.screenshots.title}</h2>
        <p class="section-subtitle">{c.screenshots.subtitle}</p>
      </div>
      <div>
        <Carousel images={polyglotImages} label="PolyglotCLI" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.caracteristicas_eyebrow')}</span>
        <h2 class="section-title">{c.features.title}</h2>
        <p class="section-subtitle">{c.features.subtitle}</p>
      </div>
      <div class="grid grid-3">
        {c.features.items.map((f) => (
          <article class="card reveal">
            <h3 class="card-title">{f.title}</h3>
            <p class="card-body" set:html={f.body} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.arquitectura_eyebrow')}</span>
        <h2 class="section-title">{c.architecture.title}</h2>
        <p class="section-subtitle">{c.architecture.subtitle}</p>
      </div>
      <div class="card reveal" style="display: flex; justify-content: center; align-items: center; overflow-x: auto;">
        <img
          src={c.architecture.image}
          alt={c.architecture.alt}
          width="1000"
          height="600"
          loading="lazy"
          decoding="async"
          style="width: 100%; max-width: 1000px; height: auto;"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.modos_uso_eyebrow')}</span>
        <h2 class="section-title">{c.usage.title}</h2>
        <p class="section-subtitle">{c.usage.subtitle}</p>
      </div>

      <div class="prose reveal">
        <h3>{c.usage.interactive.title}</h3>
        <p>{c.usage.interactive.intro}</p>
        <CodeBlock label={c.usage.interactive.copyLabel}>dotnet run</CodeBlock>

        <h3>{c.usage.direct.title}</h3>
        <p>{c.usage.direct.textIntro}</p>
        <CodeBlock label={c.usage.direct.textCopyLabel}>{`dotnet run -- \
  --files "documentos/libro.pdf" \
  --mode text`}</CodeBlock>

        <p>{c.usage.direct.imageIntro}</p>
        <CodeBlock label={c.usage.direct.imageCopyLabel}>{`dotnet run -- \
  --files "scans/recibo.pdf" \
  --mode image \
  --vision-model qwen2.5-vl-7b`}</CodeBlock>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.cli_eyebrow')}</span>
        <h2 class="section-title">{c.cli.title}</h2>
        <p class="section-subtitle">{c.cli.subtitle}</p>
      </div>
      <div class="table-wrap reveal">
        <table class="technical">
          <thead>
            <tr>
              <th>{c.cli.headers.flag}</th>
              <th>{c.cli.headers.long}</th>
              <th>{c.cli.headers.description}</th>
              <th>{c.cli.headers.default}</th>
            </tr>
          </thead>
          <tbody>
            {c.cli.options.map((o) => (
              <tr><td><code>{o.flag}</code></td><td><code>{o.long}</code></td><td set:html={o.description} /><td set:html={o.default} /></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
