---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/umbral';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = 'fitty.ar | Umbral';
const description = c.meta.description;

const umbralImages = [
  'umbral/01.png',
  'umbral/02.png',
  'umbral/03.png',
  'umbral/04.png',
];
---

<Layout title={title} description={description} ogImage="umbral/01.png">
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          {t('project_detail.open_source_eyebrow')}
        </span>

        <h1 class="hero-title">Umbral</h1>

        <p class="hero-subtitle">
          {c.hero.subtitle}
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/FittyAr/Umbral" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_codigo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a class="button button-ghost" href="https://umbral.fitty.ar/" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_demo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <a class="button button-ghost" href={`/${locale}/pages/projects.html`}>{t('project_detail.otros_proyectos')}</a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/umbral/stack</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">cat stack.yaml</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">framework</span>: Astro 7 (SSR + Node 24 standalone)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ui</span>: Alpine.js (CSP build) + Tailwind CSS v4</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">storage</span>: JSON + filesystem (no DB)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">deploy</span>: single container ~80 MB</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">docker run -d -p 3000:4321 ghcr.io/fittyar/umbral<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== CAPTURAS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
        <h2 class="section-title">{c.screenshots.title}</h2>
        <p class="section-subtitle">{c.screenshots.subtitle}</p>
      </div>
      <div>
        <Carousel images={umbralImages} label="Umbral" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.caracteristicas_eyebrow')}</span>
        <h2 class="section-title">{c.features.title}</h2>
        <p class="section-subtitle">{c.features.subtitle}</p>
      </div>
      <div class="grid grid-3">
        {c.features.items.map((f) => (
          <article class="card reveal">
            <h3 class="card-title">{f.title}</h3>
            <p class="card-body">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.arquitectura_eyebrow')}</span>
        <h2 class="section-title">{c.architecture.title}</h2>
        <p class="section-subtitle">{c.architecture.subtitle}</p>
      </div>
      <div class="card reveal" style="display: flex; justify-content: center; align-items: center; overflow-x: auto; padding: 1.5rem;">
        <pre style="font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.5; color: var(--text-muted); margin: 0; text-align: left; white-space: pre;">{c.architecture.diagram}</pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{c.deploy.eyebrow}</span>
        <h2 class="section-title">{c.deploy.title}</h2>
        <p class="section-subtitle">{c.deploy.subtitle}</p>
      </div>

      <div class="prose reveal">
        <h3>{c.deploy.run.title}</h3>
        <p>{c.deploy.run.intro}</p>
        <CodeBlock label={c.deploy.run.copyLabel}>{`docker run --pull always -d \
  --name umbral \
  -p 3000:4321 \
  -e INITIAL_PASSWORD=cambiame \
  -e SESSION_SECRET="cambiame_secreto_super_seguro_32" \
  -v umbral-data:/app/data \
  --restart unless-stopped \
  ghcr.io/fittyar/umbral:latest`}</CodeBlock>
        <p set:html={c.deploy.run.outro} />

        <h3>{c.deploy.compose.title}</h3>
        <p>{c.deploy.compose.intro}</p>
        <CodeBlock label={c.deploy.compose.copyLabel}>{`git clone https://github.com/FittyAr/Umbral.git umbral
cd umbral
cp .env.example .env
docker compose up -d`}</CodeBlock>

        <h3>{c.deploy.backup.title}</h3>
        <p>{c.deploy.backup.intro}</p>
        <CodeBlock label={c.deploy.backup.copyLabel}>{`docker run --rm -v umbral-data:/data -v .:/backup alpine \
  tar czf /backup/umbral-data.tgz -C /data .`}</CodeBlock>

        <h3>{c.deploy.update.title}</h3>
        <p set:html={c.deploy.update.intro} />
        <CodeBlock label={c.deploy.update.copyLabel}>{`docker stop umbral
docker rm umbral
docker run --pull always -d \
  --name umbral \
  -p 3000:4321 \
  -e INITIAL_PASSWORD=cambiame \
  -e SESSION_SECRET="cambiame_secreto_super_seguro_32" \
  -v umbral-data:/app/data \
  --restart unless-stopped \
  ghcr.io/fittyar/umbral:latest`}</CodeBlock>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout layout-narrow">
      <div
        class="section-header reveal center"
        style="margin-inline: auto; text-align: center;"
      >
        <span class="section-eyebrow">{c.status.eyebrow}</span>
        <h2 class="section-title">{c.status.title}</h2>
        <p class="section-subtitle" style="margin-inline: auto;">{c.status.body}</p>
        <div class="inline-actions" style="margin-top: 1.5rem; justify-content: center;">
          <a class="button button-primary" href="https://umbral.fitty.ar/" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_demo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
