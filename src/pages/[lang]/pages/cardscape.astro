---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';
import copy from '../../../i18n/projects/cardscape';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);
const c = copy[locale];

const title = 'fitty.ar | Cardscape';
const description = c.meta.description;

const cardscapeImages = [
  'cardscape/01.png',
  'cardscape/02.png',
  'cardscape/03.png',
  'cardscape/04.png',
  'cardscape/05.png',
  'cardscape/06.png',
];
---

<Layout title={title} description={description} ogImage="cardscape/01.png">
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          {t('project_detail.open_source_eyebrow')}
        </span>

        <h1 class="hero-title">Cardscape</h1>

        <p class="hero-subtitle">
          {c.hero.subtitle}
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/FittyAr/Cardscape" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_codigo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a class="button button-ghost" href={`/${locale}/pages/projects.html`}>{t('project_detail.otros_proyectos')}</a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/cardscape/stack</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">cat stack.yaml</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">runtime</span>: .NET 10 LTS · ASP.NET Core</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ui</span>: Blazor WebAssembly + Radzen</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">pipeline</span>: Wolverine · EF Core 10</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">db</span>: SQLite | PostgreSQL | MySQL | MariaDB</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ai</span>: MCP server (Streamable HTTP)</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">docker compose up -d<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== CAPTURAS -->
  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
        <h2 class="section-title">{c.screenshots.title}</h2>
        <p class="section-subtitle">{c.screenshots.subtitle}</p>
      </div>
      <div>
        <Carousel images={cardscapeImages} label="Cardscape" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.caracteristicas_eyebrow')}</span>
        <h2 class="section-title">{c.features.title}</h2>
        <p class="section-subtitle">{c.features.subtitle}</p>
      </div>
      {c.features.rows.map((row, i) => (
        <div class="grid grid-3" style={i > 0 ? 'margin-top: 1.25rem;' : undefined}>
          {row.map((f) => (
            <article class="card reveal">
              <h3 class="card-title">{f.title}</h3>
              <p class="card-body">{f.body}</p>
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.arquitectura_eyebrow')}</span>
        <h2 class="section-title">{c.architecture.title}</h2>
        <p class="section-subtitle">{c.architecture.subtitle}</p>
      </div>
      <div class="card reveal" style="display: flex; justify-content: center; align-items: center; overflow-x: auto; padding: 1.5rem;">
        <pre style="font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.5; color: var(--text-muted); margin: 0; text-align: left; white-space: pre;">{`┌────────────────────┐      ┌────────────────────┐
│  Blazor WASM (UI)  │      │  AI client (MCP)   │
│  Radzen · SignalR  │      │  Claude, IDEs, ... │
└─────────┬──────────┘      └─────────┬──────────┘
          │ REST + JWT / API token    │ Streamable HTTP + token
          ▼                           ▼
┌────────────────────┐      ┌────────────────────┐
│  Cardscape.Api     │      │  Cardscape.Mcp     │
└─────────┬──────────┘      └─────────┬──────────┘
          └─────────────┬─────────────┘
                        ▼
┌──────────────────────────────────────────────────┐
│  Application  (Wolverine · FluentValidation)     │
│  commands / queries  →  Result<T>                │
├──────────────────────────────────────────────────┤
│  Domain       (aggregates, value objects)        │
├──────────────────────────────────────────────────┤
│  Infrastructure  (EF Core 10 · jobs · storage)   │
└────────────────────────┬─────────────────────────┘
                         ▼
     SQLite  ·  PostgreSQL  ·  MySQL  ·  MariaDB`}</pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{c.deploy.eyebrow}</span>
        <h2 class="section-title">{c.deploy.title}</h2>
        <p class="section-subtitle">{c.deploy.subtitle}</p>
      </div>

      <div class="prose reveal">
        <h3>{c.deploy.selfHost.title}</h3>
        <p>{c.deploy.selfHost.intro}</p>
        <CodeBlock label={c.deploy.selfHost.copyLabel}>{`git clone https://github.com/FittyAr/Cardscape.git cardscape
cd cardscape
export CARDS_CAPE_JWT_KEY=$(openssl rand -base64 48)
docker compose up -d`}</CodeBlock>
        <p set:html={c.deploy.selfHost.outro} />

        <h3>{c.deploy.mcp.title}</h3>
        <p set:html={c.deploy.mcp.intro} />
        <CodeBlock label={c.deploy.mcp.copyLabel}>{`URL:    https://<mcp-host>/mcp
Header: Authorization: Bearer <token>`}</CodeBlock>
        <p set:html={c.deploy.mcp.outro} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout layout-narrow">
      <div
        class="section-header reveal center"
        style="margin-inline: auto; text-align: center;"
      >
        <span class="section-eyebrow">{c.status.eyebrow}</span>
        <h2 class="section-title">{c.status.title}</h2>
        <p class="section-subtitle" style="margin-inline: auto;">{c.status.body}</p>
        <div class="inline-actions" style="margin-top: 1.5rem; justify-content: center;">
          <a class="button button-primary" href="https://github.com/FittyAr/Cardscape" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_codigo')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
