---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import { useTranslations, isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(locale);

const title = 'fitty.ar | ElectroObra';
const description = locale === 'en'
  ? 'Details of ElectroObra: cross-platform system built with Avalonia UI for cash flow control and job management in small businesses.'
  : 'Detalles del proyecto ElectroObra: Sistema multiplataforma desarrollado con Avalonia UI para el control de flujo de caja y gestión de obras en pymes.';

const electroObraImages = [
  '/assets/images/projects/electro-obra/01.png',
  '/assets/images/projects/electro-obra/02.png',
  '/assets/images/projects/electro-obra/03.png',
  '/assets/images/projects/electro-obra/04.png',
  '/assets/images/projects/electro-obra/05.png',
  '/assets/images/projects/electro-obra/06.png',
  '/assets/images/projects/electro-obra/07.png',
  '/assets/images/projects/electro-obra/08.png',
  '/assets/images/projects/electro-obra/09.png',
];
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="layout hero-grid">
      <div class="reveal">
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          {locale === 'en' ? 'Operations management' : 'Gestión operativa'}
        </span>

        <h1 class="hero-title">ElectroObra</h1>

        <p class="hero-subtitle">
          {locale === 'en' ? (
            <>Cross-platform system for cash flow control and daily management of jobs and operators in small maintenance and construction businesses. Built with Avalonia UI and .NET 10.</>
          ) : (
            <>Sistema multiplataforma para el control de flujo de caja y la gestión diaria de obras y operarios en pymes de mantenimiento y construcción. Desarrollado con Avalonia UI y .NET 10.</>
          )}
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/FittyAr/ElectroObra" target="_blank" rel="noopener noreferrer">
            {t('project_detail.ver_codigo')}
            <svg class="button-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a class="button button-ghost" href={`/${locale}/pages/projects.html`}>{t('project_detail.otros_proyectos')}</a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot r"></span>
            <span class="terminal-dot y"></span>
            <span class="terminal-dot g"></span>
          </span>
          <span class="terminal-title">~/electroobra/stack</span>
          <span style="width: 36px;" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">cat stack.yaml</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">platform</span>: .NET 10.0 SDK &amp; C#</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">ui</span>: Avalonia UI 12.0+ (MVVM)</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-out"><span class="text-cyan">db</span>: SQLite &amp; Entity Framework Core</span>
          </div>
          <div class="terminal-line" style="margin-top: 1.25rem;">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">electroobra --status<span class="cursor" aria-hidden="true"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{t('project_detail.capturas_eyebrow')}</span>
        <h2 class="section-title">{locale === 'en' ? 'How ElectroObra looks.' : 'Cómo se ve ElectroObra.'}</h2>
        <p class="section-subtitle">
          {locale === 'en'
            ? 'Operations management panel with real movement loading for a small construction business.'
            : 'Panel de gestión operativa y carga de movimientos reales en una pyme de construcción.'}
        </p>
      </div>
      <div>
        <Carousel images={electroObraImages} label="ElectroObra" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">{locale === 'en' ? 'Philosophy' : 'Filosofía'}</span>
        <h2 class="section-title">{locale === 'en' ? 'Project philosophy.' : 'Filosofía del proyecto.'}</h2>
        <p class="section-subtitle">
          {locale === 'en'
            ? 'Approach focused on the day-to-day operational reality of businesses in the sector.'
            : 'Enfoque centrado en la realidad operativa cotidiana de las empresas del sector.'}
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <h3 class="card-title">{locale === 'en' ? 'Real cash flow' : 'Flujo de caja real'}</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Tracks real money movements (cash, banks, monotax, insurance, materials and tools) instead of complex fiscal accounting.'
              : 'Monitorea los movimientos reales de dinero (efectivo, bancos, monotributo, seguros, materiales y herramientas) en lugar de una contabilidad fiscal compleja.'}
          </p>
        </article>
        <article class="card reveal">
          <h3 class="card-title">{locale === 'en' ? 'Real-world flexibility' : 'Flexibilidad en el mundo real'}</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Designed handling unjustified absences, salary advances to employees, partial client payments and outstanding balances.'
              : 'Diseñado contemplando inasistencias injustificadas, adelantos de sueldo a empleados, pagos parciales de clientes y saldos pendientes de cobro.'}
          </p>
        </article>
        <article class="card reveal">
          <h3 class="card-title">{locale === 'en' ? 'Premium, portable design' : 'Diseño premium y portable'}</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Fluid, interactive interface with Avalonia UI, ready to compile natively to Desktop (Windows, Linux, macOS), Mobile (Android, iOS) and Web.'
              : 'Interfaz fluida e interactiva con Avalonia UI, preparada para compilarse nativamente para Escritorio (Windows, Linux, macOS), Móvil (Android, iOS) y Web.'}
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="layout">
      <div class="section-header reveal">
        <span class="section-eyebrow">Clean Architecture</span>
        <h2 class="section-title">{locale === 'en' ? 'Software architecture.' : 'Arquitectura de software.'}</h2>
        <p class="section-subtitle">
          {locale === 'en'
            ? 'Built under Clean Architecture principles to guarantee long-term maintainability and testability.'
            : 'Desarrollado bajo los principios de Clean Architecture para garantizar mantenibilidad a largo plazo y testabilidad.'}
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <h3 class="card-title">Core ({locale === 'en' ? 'Domain' : 'Dominio'})</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'The central layer of the business. Holds the pure domain entities (Movement, Client, Job, Employee), enumerations, specifications and repository interfaces.'
              : 'La capa central del negocio. Contiene las entidades puras de dominio (Movement, Client, Job, Employee), enumeraciones, especificaciones y las interfaces de repositorio.'}
          </p>
        </article>
        <article class="card reveal">
          <h3 class="card-title">{locale === 'en' ? 'Application' : 'Application'}</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Use cases implementation, DTOs (Data Transfer Objects), business validation through FluentValidation and simplified object mapping via Mapster.'
              : 'Implementación de los casos de uso, DTOs (Data Transfer Objects), validación de negocio mediante FluentValidation y mapeo de objetos simplificado a través de Mapster.'}
          </p>
        </article>
        <article class="card reveal">
          <h3 class="card-title">Infrastructure</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Handles database persistence with Entity Framework Core over SQLite, file system writes, PDF/Excel report export and logging.'
              : 'Maneja la persistencia en base de datos usando Entity Framework Core sobre SQLite, la escritura del sistema de archivos, exportación de reportes a PDF/Excel y el logging.'}
          </p>
        </article>
      </div>
      <div style="margin-top: 1.5rem;" class="grid grid-3">
        <article class="card reveal">
          <h3 class="card-title">{locale === 'en' ? 'UI Layer (Avalonia)' : 'UI Layer (Avalonia)'}</h3>
          <p class="card-body">
            {locale === 'en'
              ? 'Declarative, cross-platform user interface structured under the MVVM pattern, allowing 100% of the visual logic to be shared across operating systems.'
              : 'Interfaz de usuario declarativa multiplataforma estructurada bajo el patrón MVVM, permitiendo compartir el 100% de la lógica visual entre sistemas operativos.'}
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
