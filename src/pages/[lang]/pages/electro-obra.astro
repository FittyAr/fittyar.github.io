---
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

import { isLocale, DEFAULT_LOCALE, type Locale } from '../../../i18n/utils';

const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const redirectHref = `/${locale}/pages/certaro.html`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${redirectHref}`} />
    <link rel="canonical" href={redirectHref} />
    <title>Redirecting to Certaro…</title>
    <script define:vars={{ redirectHref }}>
      window.location.replace(redirectHref);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={redirectHref}>Certaro</a>…</p>
  </body>
</html>
