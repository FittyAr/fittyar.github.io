---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Si true, agrega el JSON-LD Person al head (solo en la home) */
  withStructuredData?: boolean;
}

const { title, description, withStructuredData = false } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fitty.ar';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0d" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="fitty.ar" />
    <meta property="og:image" content="https://fitty.ar/assets/images/fittyar.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fitty.ar/assets/images/fittyar.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/fittyar.png" />
    <link rel="apple-touch-icon" href="/assets/images/fittyar.png" />

    {
      withStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: 'Fitty',
            url: 'https://fitty.ar',
            sameAs: [
              'https://github.com/FittyAr',
              'https://www.instagram.com/fitty.ar',
              'https://www.linkedin.com/',
            ],
            jobTitle: 'Ingeniería de software y game dev',
            description:
              'Desarrollador .NET, entusiasta de Rust y creador de videojuegos en Godot.',
          })}
        />
      )
    }

    <ClientRouter fallback="animate" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      // =========================================================================
      // Site bootstrap: se re-ejecuta en cada navegación de View Transitions
      // =========================================================================
      function initSite() {
        // ---- Topbar scroll effect
        const topbar = document.querySelector('.topbar') as HTMLElement | null;
        if (topbar) {
          const onScroll = () => {
            topbar.classList.toggle('scrolled', window.scrollY > 20);
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // ---- Active link highlight
        const currentPath =
          (window.location.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');

        document.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href || link.origin !== window.location.origin) return;
          const linkPath =
            new URL(href, window.location.href).pathname
              .replace(/\.html$/, '')
              .replace(/\/$/, '') || '/';
          link.classList.toggle('active', linkPath === currentPath);
        });

        // ---- Mobile nav toggle
        const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
        const nav = document.querySelector('.topbar') as HTMLElement | null;
        if (navToggle && nav) {
          navToggle.addEventListener('click', () => {
            const open = nav.classList.toggle('nav-open');
            navToggle.setAttribute('aria-expanded', String(open));
          });
          // Close on link click
          document.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((link) => {
            link.addEventListener('click', () => {
              nav.classList.remove('nav-open');
              navToggle.setAttribute('aria-expanded', 'false');
            });
          });
        }

        // ---- Scroll reveal (IntersectionObserver)
        const reveals = document.querySelectorAll<HTMLElement>('.reveal');
        if (reveals.length > 0 && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
          );
          reveals.forEach((el) => io.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add('is-visible'));
        }
      }

      initSite();
      document.addEventListener('astro:after-swap', initSite);
      document.addEventListener('astro:page-load', initSite);
    </script>
  </body>
</html>
