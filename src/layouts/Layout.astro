---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { projectImage } from '../utils/project-images';
import { useTranslations, LOCALES, swapLocaleInPath, getLocaleFromPath, type Locale } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  /** Si true, agrega el JSON-LD Person al head (solo en la home) */
  withStructuredData?: boolean;
  /** Captura del proyecto para Open Graph ('umbral/01.png'). Se recorta a
      1200x630. Sin valor, se usa la imagen genérica del sitio. */
  ogImage?: string;
  /** Para páginas que no deben indexarse (404): sin canonical ni hreflang. */
  noindex?: boolean;
}

const { title, description, withStructuredData = false, ogImage, noindex = false } = Astro.props;

// Locale actual: extraído de la URL (/es/... → es, /en/... → en).
// Antes se leía de Astro.currentLocale, pero la config i18n + el
// directorio [lang]/ generaban las mismas rutas dos veces y el build
// emitía warnings de "route conflicts". Sin la config i18n, el locale
// sale limpio del primer segmento del pathname.
const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// OG locale: "es_AR" / "en_US" según el idioma.
const ogLocale = locale === 'en' ? 'en_US' : 'es_AR';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fitty.ar';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

// hreflang alternates para SEO: cada idioma apunta a su propia URL canónica.
const pathname = Astro.url.pathname;
const hreflangs = LOCALES.map((l) => ({
  lang: l,
  href: new URL(swapLocaleInPath(pathname, l), siteUrl).toString(),
}));

// Open Graph: recorte 1200x630 de la captura del proyecto, o la genérica.
const og = ogImage
  ? await getImage({ src: projectImage(ogImage), width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })
  : null;
const ogImageUrl = og ? new URL(og.src, siteUrl).toString() : `${siteUrl}/assets/images/fittyar.png`;
const ogImageWidth = og ? 1200 : 1280;
const ogImageHeight = og ? 630 : 640;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0d" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {hreflangs.map(({ lang, href }) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={hreflangs[0].href} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="fitty.ar" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts (self-hosted JetBrains Mono, @font-face en global.css) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-Bold.woff2"
      crossorigin
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/fittyar.png" />
    <link rel="apple-touch-icon" href="/assets/images/fittyar.png" />

    {
      withStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: 'Fitty',
            url: 'https://fitty.ar',
            sameAs: [
              'https://github.com/FittyAr',
              'https://www.instagram.com/fitty.ar',
              'https://www.linkedin.com/in/fittyar',
            ],
            jobTitle: 'Software developer (.NET, Rust, web)',
            description:
              'Desarrollador de software: aplicaciones a medida en .NET, herramientas en Rust y aplicaciones web. Proyectos comerciales en producción y productos propios.',
          })}
        />
      )
    }

    <!--
      Detección de idioma del sistema + persistencia.
      - Lee localStorage; si hay preferencia, no auto-redirige.
      - Si no hay, mira navigator.languages; cae a DEFAULT si nada matchea.
      - Redirige solo si el locale de la URL no coincide con el detectado.
      - Inline y chico para correr antes del primer paint y evitar FOUC.
    -->
    <script is:inline>
      (function () {
        try {
          var STORAGE_KEY = 'fitty.locale';
          var SUPPORTED = ['es', 'en'];
          var DEFAULT = 'es';

          // Si el usuario ya eligió manualmente, respetamos su elección.
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved && SUPPORTED.indexOf(saved) !== -1) return;

          // Detectar el locale preferido del browser.
          var langs = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
          var detected = null;
          for (var i = 0; i < langs.length; i++) {
            var code = (langs[i] || '').toLowerCase().split('-')[0];
            if (code === 'es' || code === 'en') { detected = code; break; }
          }
          if (!detected) detected = DEFAULT;

          // Sacar el locale actual de la URL.
          var path = window.location.pathname;
          var current = null;
          for (var j = 0; j < SUPPORTED.length; j++) {
            var l = SUPPORTED[j];
            if (path === '/' + l || path === '/' + l + '/' || path === '/' + l + '.html') { current = l; break; }
            if (path.indexOf('/' + l + '/') === 0) { current = l; break; }
          }
          if (!current) return; // sin prefijo de locale: el meta-refresh de /index.astro se encarga

          // Solo redirigir si hay mismatch entre lo detectado y la URL actual.
          if (current !== detected) {
            // Root del locale actual: '/es.html' o '/es/'. En root la swap es
            // directa al .html del otro locale. En subrutinas, reemplazamos
            // el prefijo '/<locale>/' por el del otro.
            var newPath;
            if (path === '/' + current + '.html' || path === '/' + current || path === '/' + current + '/') {
              newPath = '/' + detected + '.html';
            } else if (path.indexOf('/' + current + '/') === 0) {
              newPath = '/' + detected + '/' + path.slice(current.length + 2);
            } else {
              newPath = path;
            }
            window.location.replace(newPath);
          }
        } catch (_) { /* localStorage no disponible, etc. — ignorar */ }
      })();
    </script>

    <!--
      Reveals sin depender del bundle de JS.
      - Solo oculta contenido si hay JS, IntersectionObserver y no se pidió
        reduced-motion (agrega html.reveal-on; ver global.css).
      - window.__fittyReveal() observa .reveal y grids. Se llama al final del
        <body> (apenas está el DOM, sin esperar a los módulos) y en cada
        navegación de View Transitions.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('reveal-on');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        window.__fittyReveal = function () {
          document
            .querySelectorAll('.reveal:not(.is-visible), :is(.grid, .featured-grid, .stats, .timeline, .stack-group):not(.is-visible)')
            .forEach(function (el) { io.observe(el); });
        };
        // ClientRouter reemplaza los atributos de <html> en cada navegación.
        document.addEventListener('astro:after-swap', function () { root.classList.add('reveal-on'); });
        document.addEventListener('astro:page-load', window.__fittyReveal);
      })();
    </script>

    <ClientRouter fallback="animate" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">{t('chrome.skip_to_content')}</a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />

    <script is:inline>window.__fittyReveal && window.__fittyReveal();</script>
    <script>
      import { initSite } from '../scripts/site';
      document.addEventListener('astro:page-load', initSite);
    </script>
  </body>
</html>
