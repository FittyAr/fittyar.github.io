---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { initSite } from '../scripts/animations';

export interface Props {
  title: string;
  description: string;
  /** Si true, agrega el JSON-LD Person al head (solo en la home) */
  withStructuredData?: boolean;
}

const { title, description, withStructuredData = false } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://fitty.ar';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0d" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="fitty.ar" />
    <meta property="og:image" content="https://fitty.ar/assets/images/fittyar.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fitty.ar/assets/images/fittyar.png" />

    <!-- Fonts (self-hosted JetBrains Mono, @font-face en global.css) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-Regular.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-Bold.woff2"
      crossorigin
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/fittyar.png" />
    <link rel="apple-touch-icon" href="/assets/images/fittyar.png" />

    {
      withStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: 'Fitty',
            url: 'https://fitty.ar',
            sameAs: [
              'https://github.com/FittyAr',
              'https://www.instagram.com/fitty.ar',
              'https://www.linkedin.com/in/fittyar',
            ],
            jobTitle: 'Software developer (.NET, Rust, Godot)',
            description:
              'Desarrollador de software: aplicaciones a medida en .NET, herramientas en Rust y videojuegos en Godot. Proyectos comerciales en producción y productos propios.',
          })}
        />
      )
    }

    <ClientRouter fallback="animate" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import { initSite } from '../scripts/animations';
      initSite();
      document.addEventListener('astro:after-swap', initSite);
      document.addEventListener('astro:page-load', initSite);
    </script>
  </body>
</html>
